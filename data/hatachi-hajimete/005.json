{"title":"第五話　奥から三台目","lines":[{"no":3,"text":"火曜、六時。"},{"no":4,"text":""},{"no":5,"text":"物干し場に着くと、煙のにおいが先に来ていた。"},{"no":6,"text":""},{"no":7,"text":"律は風上三メートルに立った。昨日と同じ場所だ。"},{"no":8,"text":""},{"no":9,"text":"宇田川は一本を指に挟んで、塀を向いている。"},{"no":10,"text":""},{"no":11,"text":"「昨夜、娘に電話した」"},{"no":12,"text":""},{"no":13,"text":"律は黙っていた。"},{"no":14,"text":""},{"no":15,"text":"「吸っていたことを話した。叱られた」"},{"no":16,"text":""},{"no":17,"text":"煙が塀のほうへ流れていく。"},{"no":18,"text":""},{"no":19,"text":"「あんたのことも話した」"},{"no":20,"text":""},{"no":21,"text":"律は黙っていた。"},{"no":22,"text":""},{"no":23,"text":"「……それだけだ」"},{"no":24,"text":""},{"no":25,"text":"宇田川は半分で消し、白い紙に包んでベストに入れた。"},{"no":26,"text":""},{"no":27,"text":"「今日は、パチンコか」"},{"no":28,"text":""},{"no":29,"text":"「はい」"},{"no":30,"text":""},{"no":31,"text":"「やめとけ」"},{"no":32,"text":""},{"no":33,"text":"「十時開店です」"},{"no":34,"text":""},{"no":35,"text":"「そうか」"},{"no":36,"text":""},{"no":37,"text":"裏口の戸が閉まった。"},{"no":38,"text":""},{"no":39,"text":"◇"},{"no":40,"text":""},{"no":41,"text":"七時十分。二〇二号室。"},{"no":42,"text":""},{"no":43,"text":"律はスマホに、短く打った。"},{"no":44,"text":""},{"no":45,"text":"『今日の十時に、パーラーひまわりでパチンコをします。ゆずさんも行きますか』"},{"no":46,"text":""},{"no":47,"text":"返事は四十秒で来た。"},{"no":48,"text":""},{"no":49,"text":"『それはやだ。うるさいもん』"},{"no":50,"text":""},{"no":51,"text":"画面を二度読んだ。"},{"no":52,"text":""},{"no":53,"text":"断られた。"},{"no":54,"text":""},{"no":55,"text":"理由もついている。文面として、完成している。"},{"no":56,"text":""},{"no":57,"text":"誘って断られたのは、初めてだった。いつも断る側にいたからだ。"},{"no":58,"text":""},{"no":59,"text":"断られる側は思ったより悪くない。"},{"no":60,"text":""},{"no":61,"text":"口の端が上がっていた。指で戻す。"},{"no":62,"text":""},{"no":63,"text":"二通目が来た。"},{"no":64,"text":""},{"no":65,"text":"『お昼ならいく　たぶん』"},{"no":66,"text":""},{"no":67,"text":"「たぶん」の確認は、取れそうにない。"},{"no":68,"text":""},{"no":69,"text":"『では、十二時に入口で』と返した。"},{"no":70,"text":""},{"no":71,"text":"『りょ』"},{"no":72,"text":""},{"no":73,"text":"ノートの新しい頁を開く。"},{"no":74,"text":""},{"no":75,"text":"「予算　二千円（初心者の目安。三つのサイトで一致）」"},{"no":76,"text":""},{"no":77,"text":"「時間　四十分（同上）」"},{"no":78,"text":""},{"no":79,"text":"しおりの元の欄は「千円まで」だった。昨夜、書き直した。"},{"no":80,"text":""},{"no":81,"text":"景品交換の頁は、三頁ある。暗記は済んでいる。"},{"no":82,"text":""},{"no":83,"text":"◇"},{"no":84,"text":""},{"no":85,"text":"九時四十分。南口商店街。"},{"no":86,"text":""},{"no":87,"text":"豆腐屋のシャッターは、半分上がっていた。"},{"no":88,"text":""},{"no":89,"text":"奥から湯気が出ている。まだ客はいない。"},{"no":90,"text":""},{"no":91,"text":"律はその前を通り、商店街の外れへ向かった。"},{"no":92,"text":""},{"no":93,"text":"九時五十分。"},{"no":94,"text":""},{"no":95,"text":"パーラーひまわりの自動ドアは、閉まっていた。"},{"no":96,"text":""},{"no":97,"text":"内側に札が下がっている。「開店　十時」。"},{"no":98,"text":""},{"no":99,"text":"札の前に、まっすぐ立った。十分前の到着は、予習どおりだ。"},{"no":100,"text":""},{"no":101,"text":"頭の中で頁をめくる。景品。特殊景品。交換所。"},{"no":102,"text":""},{"no":103,"text":"台の座り方の頁は、なかった。"},{"no":104,"text":""},{"no":105,"text":"「あら、早いのね」"},{"no":106,"text":""},{"no":107,"text":"後ろから声がした。"},{"no":108,"text":""},{"no":109,"text":"薄紫のカーディガンが、視界の端に入る。"},{"no":110,"text":""},{"no":111,"text":"小さくて、丸い。首から紐で、小銭入れが下がっていた。"},{"no":112,"text":""},{"no":113,"text":"「おはようございます」"},{"no":114,"text":""},{"no":115,"text":"「おはよう」"},{"no":116,"text":""},{"no":117,"text":"それきり、二人で札を見た。"},{"no":118,"text":""},{"no":119,"text":"十時になった。"},{"no":120,"text":""},{"no":121,"text":"ドアの向こうで、店員が鍵を回す。"},{"no":122,"text":""},{"no":123,"text":"自動ドアが滑った。"},{"no":124,"text":""},{"no":125,"text":"電子音。金属の流れる音。拡声器が割れる音。"},{"no":126,"text":""},{"no":127,"text":"律の両手が耳の高さまで上がった。"},{"no":128,"text":""},{"no":129,"text":"幼いころ、この高さに母の手があった。聞かせてはいけない音だと、そう理解している。"},{"no":130,"text":""},{"no":131,"text":"「慣れるわよ」"},{"no":132,"text":""},{"no":133,"text":"後ろから、のんびりした声がした。"},{"no":134,"text":""},{"no":135,"text":"「慣れるまでの回数は、調べていません」"},{"no":136,"text":""},{"no":137,"text":"「何回かよ」"},{"no":138,"text":""},{"no":139,"text":"「何回、ですか」"},{"no":140,"text":""},{"no":141,"text":"「何回かは、何回かよ」"},{"no":142,"text":""},{"no":143,"text":"律は手を下ろした。"},{"no":144,"text":""},{"no":145,"text":"「小宮山さんで、いらっしゃいますか」"},{"no":146,"text":""},{"no":147,"text":"「ええ。ばあさん、小宮山よ。どなた？」"},{"no":148,"text":""},{"no":149,"text":"「篠原律です。大家の宇田川さんから、火曜と金曜の十時と聞きました」"},{"no":150,"text":""},{"no":151,"text":"「あらまあ。宇田川さんが、ばあさんのことを？」"},{"no":152,"text":""},{"no":153,"text":"「一度だけです」"},{"no":154,"text":""},{"no":155,"text":"「何て言ってたの」"},{"no":156,"text":""},{"no":157,"text":"「小宮山という常連がいる、と」"},{"no":158,"text":""},{"no":159,"text":"「それだけ？」"},{"no":160,"text":""},{"no":161,"text":"「それだけです」"},{"no":162,"text":""},{"no":163,"text":"「あの人らしいわ」"},{"no":164,"text":""},{"no":165,"text":"トヨが先にドアをくぐった。"},{"no":166,"text":""},{"no":167,"text":"「学生さん？」"},{"no":168,"text":""},{"no":169,"text":"「小金井学院大学の二年です。保健の先生になる勉強をしています」"},{"no":170,"text":""},{"no":171,"text":"「まあ、先生」"},{"no":172,"text":""},{"no":173,"text":"振り向いたトヨの目が、丸くなっている。"},{"no":174,"text":""},{"no":175,"text":"「先生が、パチンコなの」"},{"no":176,"text":""},{"no":177,"text":"「今日が初めてです」"},{"no":178,"text":""},{"no":179,"text":"「それは、いい日ね。先生って呼ぶわね」"},{"no":180,"text":""},{"no":181,"text":"「どうぞ」"},{"no":182,"text":""},{"no":183,"text":"◇"},{"no":184,"text":""},{"no":185,"text":"通路の両側に、台が並んでいた。"},{"no":186,"text":""},{"no":187,"text":"座っているのは年配の人ばかりで、誰も顔を上げない。"},{"no":188,"text":""},{"no":189,"text":"奥の一パチのコーナーは、台が八つだった。"},{"no":190,"text":""},{"no":191,"text":"トヨは迷わず進み、奥から三台目の椅子の背に手を置いた。軽く二度叩いてから、座る。"},{"no":192,"text":""},{"no":193,"text":"「ばあさんは、ここ。先生は、そこ」"},{"no":194,"text":""},{"no":195,"text":"「奥から四台目、ですね」"},{"no":196,"text":""},{"no":197,"text":"「そこなら、ばあさんが見えるでしょ」"},{"no":198,"text":""},{"no":199,"text":"「見えます」"},{"no":200,"text":""},{"no":201,"text":"律は座った。"},{"no":202,"text":""},{"no":203,"text":"台の上に、小さな表示板がある。「大当たり確率　三百分の一」。"},{"no":204,"text":""},{"no":205,"text":"背筋は定規のように伸びていた。膝の上で、両手がそろっている。"},{"no":206,"text":""},{"no":207,"text":"台の画面がひとりで光っている。"},{"no":208,"text":""},{"no":209,"text":"律は動かなかった。"},{"no":210,"text":""},{"no":211,"text":"一分がたった。"},{"no":212,"text":""},{"no":213,"text":"二分が近づいた。"},{"no":214,"text":""},{"no":215,"text":"「先生？」"},{"no":216,"text":""},{"no":217,"text":"「少し、お待ちください」"},{"no":218,"text":""},{"no":219,"text":"「どうしたの」"},{"no":220,"text":""},{"no":221,"text":"「確認しています」"},{"no":222,"text":""},{"no":223,"text":"「何を？」"},{"no":224,"text":""},{"no":225,"text":"「景品交換の流れです」"},{"no":226,"text":""},{"no":227,"text":"「あらまあ」"},{"no":228,"text":""},{"no":229,"text":"「出た玉は、景品に替えます」"},{"no":230,"text":""},{"no":231,"text":"「ええ、そうね」"},{"no":232,"text":""},{"no":233,"text":"「景品は、店の外で現金になります」"},{"no":234,"text":""},{"no":235,"text":"「ええ」"},{"no":236,"text":""},{"no":237,"text":"「ですが、玉の出し方は、調べていません」"},{"no":238,"text":""},{"no":239,"text":"トヨは自分の台から、身を乗り出した。"},{"no":240,"text":""},{"no":241,"text":"「そんなに調べてきたのに？」"},{"no":242,"text":""},{"no":243,"text":"「はい」"},{"no":244,"text":""},{"no":245,"text":"「ばあさんはね、この台の確率も知らないのよ」"},{"no":246,"text":""},{"no":247,"text":"「三百分の一です。上に書いてあります」"},{"no":248,"text":""},{"no":249,"text":"「あら、書いてあるの」"},{"no":250,"text":""},{"no":251,"text":"トヨは台の上を見上げた。"},{"no":252,"text":""},{"no":253,"text":"「じゃあ、順番に教えるわね。先生、お札は？」"},{"no":254,"text":""},{"no":255,"text":"律は財布から千円札を二枚出した。折れ目がない。"},{"no":256,"text":""},{"no":257,"text":"トヨは首の小銭入れから、四つ折りの千円札を一枚出していた。"},{"no":258,"text":""},{"no":259,"text":"「お札、入れて」"},{"no":260,"text":""},{"no":261,"text":"「どこにですか」"},{"no":262,"text":""},{"no":263,"text":"「右の、細い口」"},{"no":264,"text":""},{"no":265,"text":"「ここですか」"},{"no":266,"text":""},{"no":267,"text":"「向きは、どっちでもいいのよ」"},{"no":268,"text":""},{"no":269,"text":"「どちらでも」"},{"no":270,"text":""},{"no":271,"text":"札はすっと吸い込まれた。"},{"no":272,"text":""},{"no":273,"text":"「次、ボタン。貸し玉って書いてあるの」"},{"no":274,"text":""},{"no":275,"text":"「押しました」"},{"no":276,"text":""},{"no":277,"text":"皿に玉が落ちた。ひと握りの銀色が、皿の底で鳴った。"},{"no":278,"text":""},{"no":279,"text":"「ばあさんは、千円分だけなの。帰りに豆腐屋さんに寄るから」"},{"no":280,"text":""},{"no":281,"text":"「豆腐ですか」"},{"no":282,"text":""},{"no":283,"text":"「そう。最後は、ハンドル。右に回して」"},{"no":284,"text":""},{"no":285,"text":"「どのくらいですか」"},{"no":286,"text":""},{"no":287,"text":"「好きなだけ」"},{"no":288,"text":""},{"no":289,"text":"「好きなだけ、の数値は」"},{"no":290,"text":""},{"no":291,"text":"「ないわよ」"},{"no":292,"text":""},{"no":293,"text":"「ないのですか」"},{"no":294,"text":""},{"no":295,"text":"「ないの」"},{"no":296,"text":""},{"no":297,"text":"律は右手でハンドルをつかんだ。"},{"no":298,"text":""},{"no":299,"text":"好きなだけ回した。"},{"no":300,"text":""},{"no":301,"text":"止まるところまで、回した。"},{"no":302,"text":""},{"no":303,"text":"玉がひとつずつ飛び出し始めた。"},{"no":304,"text":""},{"no":305,"text":"◇"},{"no":306,"text":""},{"no":307,"text":"七分後。"},{"no":308,"text":""},{"no":309,"text":"律は画面を見ていた。何も出ない。"},{"no":310,"text":""},{"no":311,"text":"「小宮山さん。画面は、いつ変わりますか」"},{"no":312,"text":""},{"no":313,"text":"「当たるときよ」"},{"no":314,"text":""},{"no":315,"text":"「それは、いつですか」"},{"no":316,"text":""},{"no":317,"text":"「当たるときよ」"},{"no":318,"text":""},{"no":319,"text":"律はふと、横を見た。"},{"no":320,"text":""},{"no":321,"text":"トヨの皿には玉が半分も残っている。"},{"no":322,"text":""},{"no":323,"text":"右手はハンドルの上でほとんど動かない。玉は間を置いて、一つずつ飛んでいく。"},{"no":324,"text":""},{"no":325,"text":"「小宮山さんは、何を基準に止めるのですか」"},{"no":326,"text":""},{"no":327,"text":"「千円」"},{"no":328,"text":""},{"no":329,"text":"「千円」"},{"no":330,"text":""},{"no":331,"text":"「なくなったら、帰るの」"},{"no":332,"text":""},{"no":333,"text":"「確率や回転数は」"},{"no":334,"text":""},{"no":335,"text":"「知らないわよ」"},{"no":336,"text":""},{"no":337,"text":"「それでは、数字がありません」"},{"no":338,"text":""},{"no":339,"text":"「千円があるでしょ」"},{"no":340,"text":""},{"no":341,"text":"律は自分の皿を見た。"},{"no":342,"text":""},{"no":343,"text":"玉はもう、底が見えていた。"},{"no":344,"text":""},{"no":345,"text":"十四分後。"},{"no":346,"text":""},{"no":347,"text":"皿は空になった。"},{"no":348,"text":""},{"no":349,"text":"画面は何も起こさなかった。"},{"no":350,"text":""},{"no":351,"text":"「二千円が終わりました」"},{"no":352,"text":""},{"no":353,"text":"「あらまあ、早い」"},{"no":354,"text":""},{"no":355,"text":"「十四分です。予定は四十分でした」"},{"no":356,"text":""},{"no":357,"text":"「ハンドル、全部回してたでしょ」"},{"no":358,"text":""},{"no":359,"text":"「好きなだけ、と言われましたので」"},{"no":360,"text":""},{"no":361,"text":"「言ったわね」"},{"no":362,"text":""},{"no":363,"text":"トヨは自分の右手を宙で動かした。"},{"no":364,"text":""},{"no":365,"text":"「半分でいいのよ。そーっと」"},{"no":366,"text":""},{"no":367,"text":"「半分の数値は」"},{"no":368,"text":""},{"no":369,"text":"「ないわよ」"},{"no":370,"text":""},{"no":371,"text":"律はノートを膝の上で開いた。"},{"no":372,"text":""},{"no":373,"text":"「二千円　十四分」"},{"no":374,"text":""},{"no":375,"text":"「予定　四十分」"},{"no":376,"text":""},{"no":377,"text":"「残り　二十六分」"},{"no":378,"text":""},{"no":379,"text":"二千円が尽きたのに、時間だけが余っている。"},{"no":380,"text":""},{"no":381,"text":"「小宮山さん」"},{"no":382,"text":""},{"no":383,"text":"「なあに」"},{"no":384,"text":""},{"no":385,"text":"「追加で、千円を入れます」"},{"no":386,"text":""},{"no":387,"text":"「あら。お金のお約束が先でしょ」"},{"no":388,"text":""},{"no":389,"text":"「約束は、二つあります。二千円と、四十分です」"},{"no":390,"text":""},{"no":391,"text":"「ふたつ」"},{"no":392,"text":""},{"no":393,"text":"「片方だけ守ると、もう片方が余ります」"},{"no":394,"text":""},{"no":395,"text":"「余ると、困るの？」"},{"no":396,"text":""},{"no":397,"text":"「予習が、完了しません」"},{"no":398,"text":""},{"no":399,"text":"トヨは自分の台を見る。少し考える間があった。"},{"no":400,"text":""},{"no":401,"text":"「先生、千円はね、遊ぶお金なの。足すお金じゃないのよ」"},{"no":402,"text":""},{"no":403,"text":"「承知しております」"},{"no":404,"text":""},{"no":405,"text":"律は三枚目の千円札を出した。"},{"no":406,"text":""},{"no":407,"text":"「承知してるのに、入れるのね」"},{"no":408,"text":""},{"no":409,"text":"「入れます」"},{"no":410,"text":""},{"no":411,"text":"トヨはそれ以上言わなかった。"},{"no":412,"text":""},{"no":413,"text":"ハンドルを半分に回すと、玉の減りが遅くなった。"},{"no":414,"text":""},{"no":415,"text":"八分が過ぎた。"},{"no":416,"text":""},{"no":417,"text":"壁の時計は十時二十七分を指している。四十分の予定は、十時四十五分までだ。"},{"no":418,"text":""},{"no":419,"text":"隣で、画面が白く光った。"},{"no":420,"text":""},{"no":421,"text":"ドアの音とは比べものにならない音量で、曲が鳴り出す。"},{"no":422,"text":""},{"no":423,"text":"律の両手がまた上がった。"},{"no":424,"text":""},{"no":425,"text":"今度は座ったままだった。"},{"no":426,"text":""},{"no":427,"text":"「あらやだ」"},{"no":428,"text":""},{"no":429,"text":"トヨの声は小さかった。"},{"no":430,"text":""},{"no":431,"text":"「当たっちゃった」"},{"no":432,"text":""},{"no":433,"text":"「おめでとうございます」"},{"no":434,"text":""},{"no":435,"text":"「ありがとう、先生」"},{"no":436,"text":""},{"no":437,"text":"礼を言いながら、トヨは笑っていなかった。"},{"no":438,"text":""},{"no":439,"text":"トヨが見ているのは、自分の右手が握るハンドルだった。"},{"no":440,"text":""},{"no":441,"text":"左手が首の小銭入れの紐を一度だけ握る。"},{"no":442,"text":""},{"no":443,"text":"当たった人は喜ぶものだと、律は予習していた。"},{"no":444,"text":""},{"no":445,"text":"外れた。"},{"no":446,"text":""},{"no":447,"text":"三台目の皿に、玉が流れ込んでいく。トヨは両手で、皿の縁を押さえた。"},{"no":448,"text":""},{"no":449,"text":"曲は鳴り続けている。律は耳に手を当てたまま、横を向いていた。"},{"no":450,"text":""},{"no":451,"text":"自分の皿は、いつの間にか空になっている。"},{"no":452,"text":""},{"no":453,"text":"十三分。"},{"no":454,"text":""},{"no":455,"text":"律は耳から手を離した。"},{"no":456,"text":""},{"no":457,"text":"「小宮山さん。わたしは、これで終わりです」"},{"no":458,"text":""},{"no":459,"text":"「あら、そう」"},{"no":460,"text":""},{"no":461,"text":"「予算を、千円超過しました」"},{"no":462,"text":""},{"no":463,"text":"「いけない子ね」"},{"no":464,"text":""},{"no":465,"text":"そこでトヨが少しだけ笑った。"},{"no":466,"text":""},{"no":467,"text":"「小宮山さんは、続けるのですか」"},{"no":468,"text":""},{"no":469,"text":"「当たった日はね、お皿に玉が残るでしょ」"},{"no":470,"text":""},{"no":471,"text":"「はい」"},{"no":472,"text":""},{"no":473,"text":"「残った分をどうしようかしらって、考えるのよ」"},{"no":474,"text":""},{"no":475,"text":"トヨの目はハンドルに戻っていた。"},{"no":476,"text":""},{"no":477,"text":"律は席を立った。"},{"no":478,"text":""},{"no":479,"text":"立ってから、気づいた。"},{"no":480,"text":""},{"no":481,"text":"二千円も四十分も、三つのサイトの数字だった。"},{"no":482,"text":""},{"no":483,"text":"「小宮山さん」"},{"no":484,"text":""},{"no":485,"text":"「なあに、先生」"},{"no":486,"text":""},{"no":487,"text":"「金曜も、来ます」"},{"no":488,"text":""},{"no":489,"text":"言ってから、律は自分で驚いた。予定表には書いていない。"},{"no":490,"text":""},{"no":491,"text":"「待ってるわ」"},{"no":492,"text":""},{"no":493,"text":"トヨは台を向いたまま、小さく手を振った。"},{"no":494,"text":""},{"no":495,"text":"◇"},{"no":496,"text":""},{"no":497,"text":"店を出てから、律は商店街の端で一時間半、景品交換の窓口を眺めていた。"},{"no":498,"text":""},{"no":499,"text":"十二時。"},{"no":500,"text":""},{"no":501,"text":"パーラーひまわりの前に、ゆずが立っていた。"},{"no":502,"text":""},{"no":503,"text":"肩にトートバッグ。毛先はいつもの方向にはねている。"},{"no":504,"text":""},{"no":505,"text":"「りっちゃん！　来たよ、お昼」"},{"no":506,"text":""},{"no":507,"text":"「十二時ちょうどです」"},{"no":508,"text":""},{"no":509,"text":"「あたし、えらくない？」"},{"no":510,"text":""},{"no":511,"text":"「時間どおりです。ふつうです」"},{"no":512,"text":""},{"no":513,"text":"「えらいって言ってよ」"},{"no":514,"text":""},{"no":515,"text":"「えらいです」"},{"no":516,"text":""},{"no":517,"text":"「雑」"},{"no":518,"text":""},{"no":519,"text":"二人で自動ドアの前に立った。"},{"no":520,"text":""},{"no":521,"text":"ドアが滑る。"},{"no":522,"text":""},{"no":523,"text":"音が出てきた。"},{"no":524,"text":""},{"no":525,"text":"ゆずの両手が先に上がった。両耳をぴったり押さえている。"},{"no":526,"text":""},{"no":527,"text":"律の手も上がりかけた。肩の高さまで。"},{"no":528,"text":""},{"no":529,"text":"止めて、コートのポケットに入れる。"},{"no":530,"text":""},{"no":531,"text":"「りっちゃん、手」"},{"no":532,"text":""},{"no":533,"text":"「ポケットです」"},{"no":534,"text":""},{"no":535,"text":"「なんで」"},{"no":536,"text":""},{"no":537,"text":"「入れておけば、上がりません」"},{"no":538,"text":""},{"no":539,"text":"「それ、予習？」"},{"no":540,"text":""},{"no":541,"text":"「いま、考えました」"},{"no":542,"text":""},{"no":543,"text":"ゆずは耳を押さえたまま、一歩入った。"},{"no":544,"text":""},{"no":545,"text":"律は入口で時計を見た。"},{"no":546,"text":""},{"no":547,"text":"二分四十秒で、ゆずが出てきた。"},{"no":548,"text":""},{"no":549,"text":"早足だった。ドアの外で、手を下ろす。"},{"no":550,"text":""},{"no":551,"text":"「やっぱ無理。うるさいもん」"},{"no":552,"text":""},{"no":553,"text":"そのまま、ゆずは笑う。"},{"no":554,"text":""},{"no":555,"text":"謝らなかった。"},{"no":556,"text":""},{"no":557,"text":"誰にも押されず、自分で出てきた。律はそれを、目で確かめた。"},{"no":558,"text":""},{"no":559,"text":"「無理、と言えましたね」"},{"no":560,"text":""},{"no":561,"text":"「え、なにそれ。褒めてる？」"},{"no":562,"text":""},{"no":563,"text":"「確認です」"},{"no":564,"text":""},{"no":565,"text":"「あたし、入って三秒で無理って思ったよ」"},{"no":566,"text":""},{"no":567,"text":"「二分四十秒、中にいました」"},{"no":568,"text":""},{"no":569,"text":"「うそ。そんなにいた？」"},{"no":570,"text":""},{"no":571,"text":"「いました」"},{"no":572,"text":""},{"no":573,"text":"ゆずは商店街のベンチに腰を下ろした。"},{"no":574,"text":""},{"no":575,"text":"「あたし、ここで待つ。りっちゃんは？」"},{"no":576,"text":""},{"no":577,"text":"「わたしは、もう終わりました。三千円で、二十七分です」"},{"no":578,"text":""},{"no":579,"text":"「三千円？」"},{"no":580,"text":""},{"no":581,"text":"「予算は、二千円でした」"},{"no":582,"text":""},{"no":583,"text":"「オーバーじゃん」"},{"no":584,"text":""},{"no":585,"text":"「千円、超過しました」"},{"no":586,"text":""},{"no":587,"text":"「りっちゃんが、予算オーバー！　初めて見た」"},{"no":588,"text":""},{"no":589,"text":"「わたしも、初めて見ました」"},{"no":590,"text":""},{"no":591,"text":"律もベンチに座った。"},{"no":592,"text":""},{"no":593,"text":"「手、さっき上がりかけて、ポケットに入ったでしょ」"},{"no":594,"text":""},{"no":595,"text":"「見ていたのですか」"},{"no":596,"text":""},{"no":597,"text":"「見てた。あたしも覚えた」"},{"no":598,"text":""},{"no":599,"text":"「学習です」"},{"no":600,"text":""},{"no":601,"text":"「で、金曜も行くの？」"},{"no":602,"text":""},{"no":603,"text":"「行きます」"},{"no":604,"text":""},{"no":605,"text":"「うるさいのに」"},{"no":606,"text":""},{"no":607,"text":"「小宮山さんが、待っているので」"},{"no":608,"text":""},{"no":609,"text":"「友だち？」"},{"no":610,"text":""},{"no":611,"text":"「顔見知りです。今朝まで、知らない人でした」"},{"no":612,"text":""},{"no":613,"text":"「あたしは行かないよ。うるさいから」"},{"no":614,"text":""},{"no":615,"text":"「知っています」"},{"no":616,"text":""},{"no":617,"text":"「おなか、すいたね」"},{"no":618,"text":""},{"no":619,"text":"「十二時三十分です」"},{"no":620,"text":""},{"no":621,"text":"「それ、答え？」"},{"no":622,"text":""},{"no":623,"text":"◇"},{"no":624,"text":""},{"no":625,"text":"その夜。"},{"no":626,"text":""},{"no":627,"text":"ノートの新しい頁に、律は書いた。"},{"no":628,"text":""},{"no":629,"text":"「十七日（火）九時五十分〜十二時三十分」"},{"no":630,"text":""},{"no":631,"text":"「二千円　十四分（一分あたり百四十三円）」"},{"no":632,"text":""},{"no":633,"text":"「追加の千円　十三分（一分あたり七十七円）」"},{"no":634,"text":""},{"no":635,"text":"「合計　三千円　二十七分（一分あたり百十一円）」"},{"no":636,"text":""},{"no":637,"text":"「予算超過　千円」"},{"no":638,"text":""},{"no":639,"text":"「予算の出どころ　三つのサイト（自分で決めた数字　〇）」"},{"no":640,"text":""},{"no":641,"text":"「手が耳まで上がった回数　二回（ドア、当たり）　ポケット　一回」"},{"no":642,"text":""},{"no":643,"text":"「小宮山さん　当たり一回（笑顔は確認できず）」"},{"no":644,"text":""},{"no":645,"text":"「宇田川さん　朝六時の物干し場で、昨夜の娘さんへの電話を報告」"},{"no":646,"text":""},{"no":647,"text":"「景品交換　未使用」"},{"no":648,"text":""},{"no":649,"text":"景品交換の頁は、三頁ある。使う玉が、最初から一つもなかった。"},{"no":650,"text":""},{"no":651,"text":"次の行に、書いた。"},{"no":652,"text":""},{"no":653,"text":"「金曜　予算　（　）」"},{"no":654,"text":""},{"no":655,"text":"括弧の中は、まだ空白だった。"}],"illus":[]}