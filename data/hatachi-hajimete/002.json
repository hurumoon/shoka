{"title":"第二話　お通しはサービス","lines":[{"no":3,"text":"十七時五十五分。"},{"no":4,"text":""},{"no":5,"text":"串焼き 角ふくは、駅北口の高架下にあった。"},{"no":6,"text":""},{"no":7,"text":"頭の上を電車が通る。壁が低く鳴って、静まった。"},{"no":8,"text":""},{"no":9,"text":"「振動は、想定外です」"},{"no":10,"text":""},{"no":11,"text":"律は引き戸の前で腕時計を見た。"},{"no":12,"text":""},{"no":13,"text":"約束は十八時。五分前の到着は、予習どおりだ。"},{"no":14,"text":""},{"no":15,"text":"戸を開ける。"},{"no":16,"text":""},{"no":17,"text":"「いらっしゃい」"},{"no":18,"text":""},{"no":19,"text":"カウンターの中に、頭にタオルを巻いた男が立っている。四十代。"},{"no":20,"text":""},{"no":21,"text":"胸に「角田」の名札があった。"},{"no":22,"text":""},{"no":23,"text":"「十八時に、牧野ゆずさんと約束しています。篠原です」"},{"no":24,"text":""},{"no":25,"text":"「聞いてる」"},{"no":26,"text":""},{"no":27,"text":"「予約は、ありますか」"},{"no":28,"text":""},{"no":29,"text":"「ない」"},{"no":30,"text":""},{"no":31,"text":"「牧野さんは、たぶん大丈夫と」"},{"no":32,"text":""},{"no":33,"text":"「空いてる」"},{"no":34,"text":""},{"no":35,"text":"席は八つ。奥に座敷が一つ。"},{"no":36,"text":""},{"no":37,"text":"客は一人もいなかった。"},{"no":38,"text":""},{"no":39,"text":"律はかばんから学生証と免許証を出し、カウンターに並べた。"},{"no":40,"text":""},{"no":41,"text":"「何だ」"},{"no":42,"text":""},{"no":43,"text":"「年齢確認です。本日、二十歳になりました」"},{"no":44,"text":""},{"no":45,"text":"角田は二枚を見て、律の顔を見て、もう一度二枚を見た。"},{"no":46,"text":""},{"no":47,"text":"「知ってる。ゆずから聞いた」"},{"no":48,"text":""},{"no":49,"text":"「見なくてよろしいのですか」"},{"no":50,"text":""},{"no":51,"text":"「見た」"},{"no":52,"text":""},{"no":53,"text":"律は二枚をしまった。"},{"no":54,"text":""},{"no":55,"text":"端の席に座り、ノートを置く。"},{"no":56,"text":""},{"no":57,"text":"小鉢が出てきた。ひじきの煮物だ。"},{"no":58,"text":""},{"no":59,"text":"「お通し。サービス」"},{"no":60,"text":""},{"no":61,"text":"予習では、お通しは席料の代わりに出る。たいていは有料で、三百円から五百円。"},{"no":62,"text":""},{"no":63,"text":"「サービス、とは」"},{"no":64,"text":""},{"no":65,"text":"「サービス」"},{"no":66,"text":""},{"no":67,"text":"「無料という意味でしょうか」"},{"no":68,"text":""},{"no":69,"text":"「サービス」"},{"no":70,"text":""},{"no":71,"text":"角田は背を向けて、串をひっくり返しはじめる。"},{"no":72,"text":""},{"no":73,"text":"回答は「サービス」で一貫している。ただ、根拠の欄は空いたままだ。"},{"no":74,"text":""},{"no":75,"text":"「お通し　サービス（口頭。根拠、未確認）」"},{"no":76,"text":""},{"no":77,"text":"ノートに書いた。"},{"no":78,"text":""},{"no":79,"text":"「お飲み物は」"},{"no":80,"text":""},{"no":81,"text":"「連れが来てからにします」"},{"no":82,"text":""},{"no":83,"text":"「そうか」"},{"no":84,"text":""},{"no":85,"text":"水が出た。氷が三つ入っていた。"},{"no":86,"text":""},{"no":87,"text":"十八時十分。"},{"no":88,"text":""},{"no":89,"text":"予習の十一項目を、声に出さずに読み直す。"},{"no":90,"text":""},{"no":91,"text":"口だけが動いた。角田が串の向こうから、一度見た。"},{"no":92,"text":""},{"no":93,"text":"十八時二十分。"},{"no":94,"text":""},{"no":95,"text":"引き戸が開いて、作業服の男が入ってきた。"},{"no":96,"text":""},{"no":97,"text":"「おう」"},{"no":98,"text":""},{"no":99,"text":"「おう」"},{"no":100,"text":""},{"no":101,"text":"角田と一語ずつ交わして、男は端から三つ目に座る。"},{"no":102,"text":""},{"no":103,"text":"注文はない。瓶ビールとグラスが、黙って出てきた。"},{"no":104,"text":""},{"no":105,"text":"十八時四十分。"},{"no":106,"text":""},{"no":107,"text":"同じ要領で、帽子の男と眼鏡の男が来た。三人が並んで座る。"},{"no":108,"text":""},{"no":109,"text":"「ゆずちゃんは」"},{"no":110,"text":""},{"no":111,"text":"作業服の男が聞いた。"},{"no":112,"text":""},{"no":113,"text":"「あとで来る」"},{"no":114,"text":""},{"no":115,"text":"「今日も遅刻か」"},{"no":116,"text":""},{"no":117,"text":"「たぶん」"},{"no":118,"text":""},{"no":119,"text":"角田まで「たぶん」と言った。"},{"no":120,"text":""},{"no":121,"text":"律はノートに書いた。「遅刻、常習の可能性」"},{"no":122,"text":""},{"no":123,"text":"眼鏡の男がノートに目をとめた。"},{"no":124,"text":""},{"no":125,"text":"「姉ちゃん、ゆずちゃんの友達か」"},{"no":126,"text":""},{"no":127,"text":"「同期の、篠原律です」"},{"no":128,"text":""},{"no":129,"text":"「何の勉強してんの」"},{"no":130,"text":""},{"no":131,"text":"「養護教育です。保健室の先生になる課程です」"},{"no":132,"text":""},{"no":133,"text":"「保健室か。この店に、いちばん要る人だ」"},{"no":134,"text":""},{"no":135,"text":"三人の男が笑った。"},{"no":136,"text":""},{"no":137,"text":"「飲酒の健康被害の授業は、最高評価で修了しました」"},{"no":138,"text":""},{"no":139,"text":"「そりゃ頼もしい」"},{"no":140,"text":""},{"no":141,"text":"「ありがとうございます」"},{"no":142,"text":""},{"no":143,"text":"褒められたのかどうか、律には確認がつかなかった。"},{"no":144,"text":""},{"no":145,"text":"十八時五十分。"},{"no":146,"text":""},{"no":147,"text":"水の氷が一つになっていた。"},{"no":148,"text":""},{"no":149,"text":"角田は串を返す手の合間に、引き戸のほうを一度見た。何も言わない。"},{"no":150,"text":""},{"no":151,"text":"十八時五十五分。"},{"no":152,"text":""},{"no":153,"text":"引き戸が勢いよく開いた。"},{"no":154,"text":""},{"no":155,"text":"「ごめーん！」"},{"no":156,"text":""},{"no":157,"text":"肩までの茶髪。毛先ははねている。"},{"no":158,"text":""},{"no":159,"text":"大きなトートバッグが、戸にぶつかった。"},{"no":160,"text":""},{"no":161,"text":"「五十五分の遅刻です」"},{"no":162,"text":""},{"no":163,"text":"「え、そんなに？」"},{"no":164,"text":""},{"no":165,"text":"「約束は十八時でした」"},{"no":166,"text":""},{"no":167,"text":"「でも、それくらいって言ったじゃん」"},{"no":168,"text":""},{"no":169,"text":"「許容範囲は、五分から三十分と」"},{"no":170,"text":""},{"no":171,"text":"「あー、超えたか。ごめん」"},{"no":172,"text":""},{"no":173,"text":"「理由を伺っても」"},{"no":174,"text":""},{"no":175,"text":"「えーと。なんか、ふわっと」"},{"no":176,"text":""},{"no":177,"text":"「ふわっと」"},{"no":178,"text":""},{"no":179,"text":"「出ようとしたら、ふわっと、こんな時間」"},{"no":180,"text":""},{"no":181,"text":"律はノートに書いた。"},{"no":182,"text":""},{"no":183,"text":"「理由　ふわっと」"},{"no":184,"text":""},{"no":185,"text":"◇"},{"no":186,"text":""},{"no":187,"text":"ゆずは律の隣に座ると、トートバッグに腕を突っ込んだ。"},{"no":188,"text":""},{"no":189,"text":"出てきたのは、レシート、ハンカチ、のど飴、鍵。"},{"no":190,"text":""},{"no":191,"text":"「ちょっと待って、あった、これ」"},{"no":192,"text":""},{"no":193,"text":"薄い包みだった。"},{"no":194,"text":""},{"no":195,"text":"「りっちゃん、誕生日おめでとう！」"},{"no":196,"text":""},{"no":197,"text":"「ありがとうございます。開けても」"},{"no":198,"text":""},{"no":199,"text":"「どうぞどうぞ」"},{"no":200,"text":""},{"no":201,"text":"付箋のパッドが五つ、重ねてあった。"},{"no":202,"text":""},{"no":203,"text":"赤。青。黄。緑。ピンク。"},{"no":204,"text":""},{"no":205,"text":"「りっちゃんの付箋、いっつも三色じゃん。青と黄色と赤」"},{"no":206,"text":""},{"no":207,"text":"「見ていたのですか」"},{"no":208,"text":""},{"no":209,"text":"「見てるよー。同じ授業だもん」"},{"no":210,"text":""},{"no":211,"text":"「青は法とマナー。黄はリスクと数字。赤は未確認です」"},{"no":212,"text":""},{"no":213,"text":"「うん。よく分かんないけど、うん」"},{"no":214,"text":""},{"no":215,"text":"赤のパッドを手に取る。"},{"no":216,"text":""},{"no":217,"text":"昨夜、最後の一枚を使い切った色だった。"},{"no":218,"text":""},{"no":219,"text":"「赤は、足りなくなりました。昨夜」"},{"no":220,"text":""},{"no":221,"text":"「ほらー。ちょうどじゃん」"},{"no":222,"text":""},{"no":223,"text":"「緑とピンクは、用途が決まっていません」"},{"no":224,"text":""},{"no":225,"text":"「ピンクかわいくない？」"},{"no":226,"text":""},{"no":227,"text":"「用途としては、不明です」"},{"no":228,"text":""},{"no":229,"text":"「かわいいが用途だよ」"},{"no":230,"text":""},{"no":231,"text":"律は五つのパッドをそろえて、ノートの表紙の内側に挟んだ。"},{"no":232,"text":""},{"no":233,"text":"「大切に使います」"},{"no":234,"text":""},{"no":235,"text":"「使って使って」"},{"no":236,"text":""},{"no":237,"text":"角田が来て、鉛筆を構えた。"},{"no":238,"text":""},{"no":239,"text":"「飲み物」"},{"no":240,"text":""},{"no":241,"text":"「とりあえず生、ふたつ！」"},{"no":242,"text":""},{"no":243,"text":"「待ってください。『とりあえず生』は、注文を早く済ませるための言い方で、語源には諸説あり、まず――」"},{"no":244,"text":""},{"no":245,"text":"「りっちゃん」"},{"no":246,"text":""},{"no":247,"text":"「はい」"},{"no":248,"text":""},{"no":249,"text":"「角田さん、待ってる」"},{"no":250,"text":""},{"no":251,"text":"角田は鉛筆を構えたまま、待っていた。"},{"no":252,"text":""},{"no":253,"text":"「……失礼しました」"},{"no":254,"text":""},{"no":255,"text":"「てかさ、初めてだし、ミニにしとく？」"},{"no":256,"text":""},{"no":257,"text":"「ミニ、とは」"},{"no":258,"text":""},{"no":259,"text":"「小さいやつ」"},{"no":260,"text":""},{"no":261,"text":"「二百」"},{"no":262,"text":""},{"no":263,"text":"角田が言った。"},{"no":264,"text":""},{"no":265,"text":"「二百ミリリットルなら、純アルコール八グラムです」"},{"no":266,"text":""},{"no":267,"text":"「うん。あたしは中ね。強いほうだから」"},{"no":268,"text":""},{"no":269,"text":"「ミニ、ひとつ。中、ひとつ」"},{"no":270,"text":""},{"no":271,"text":"角田は復唱して、サーバーへ向かった。"},{"no":272,"text":""},{"no":273,"text":"グラスが二つ、カウンターに並んだ。"},{"no":274,"text":""},{"no":275,"text":"中ジョッキはミニの二倍半あった。"},{"no":276,"text":""},{"no":277,"text":"「じゃ、乾杯しよ。かんぱーい！」"},{"no":278,"text":""},{"no":279,"text":"ゆずがグラスを胸の高さに上げた。"},{"no":280,"text":""},{"no":281,"text":"「乾杯は、相手より低くです」"},{"no":282,"text":""},{"no":283,"text":"律はグラスを、ゆずのより五センチ下に出した。"},{"no":284,"text":""},{"no":285,"text":"「え」"},{"no":286,"text":""},{"no":287,"text":"ゆずが笑って、グラスを少し下げた。"},{"no":288,"text":""},{"no":289,"text":"律も下げた。ゆずより低く。"},{"no":290,"text":""},{"no":291,"text":"「低くない？」"},{"no":292,"text":""},{"no":293,"text":"「相手より低く、です」"},{"no":294,"text":""},{"no":295,"text":"ゆずがさらに下げる。律も下げる。"},{"no":296,"text":""},{"no":297,"text":"作業服の男がこちらを向いた。"},{"no":298,"text":""},{"no":299,"text":"ゆずのグラスは、カウンターの面に近づいていく。律のそれは、もう面についていた。"},{"no":300,"text":""},{"no":301,"text":"「これ以上は、低くできません」"},{"no":302,"text":""},{"no":303,"text":"「机じゃん」"},{"no":304,"text":""},{"no":305,"text":"「机の下は、構造上、不可能です」"},{"no":306,"text":""},{"no":307,"text":"「ははは！」"},{"no":308,"text":""},{"no":309,"text":"ゆずは笑いながらジョッキを寄せ、ミニ生の頭にコツンと当てた。"},{"no":310,"text":""},{"no":311,"text":"乾杯だった。たぶん。"},{"no":312,"text":""},{"no":313,"text":"律は口の中で三秒数えてから、一口飲んだ。"},{"no":314,"text":""},{"no":315,"text":"「……苦い」"},{"no":316,"text":""},{"no":317,"text":"「でしょ？」"},{"no":318,"text":""},{"no":319,"text":"「ですが、昨夜より冷たいです」"},{"no":320,"text":""},{"no":321,"text":"「サーバーだもん」"},{"no":322,"text":""},{"no":323,"text":"ゆずはジョッキを傾けた。のどが三回動いて、半分が消えた。"},{"no":324,"text":""},{"no":325,"text":"「ぷはー。いけるいける」"},{"no":326,"text":""},{"no":327,"text":"「てかさ、串も頼もっか。りっちゃん、何食べる？」"},{"no":328,"text":""},{"no":329,"text":"「予習した部位は、ねぎま、皮、つくね、ぼんじりです」"},{"no":330,"text":""},{"no":331,"text":"「ぼんじり？」"},{"no":332,"text":""},{"no":333,"text":"「鳥の尾の付け根です」"},{"no":334,"text":""},{"no":335,"text":"「そう言われると、食べづらい」"},{"no":336,"text":""},{"no":337,"text":"「訂正します。おいしい部位です」"},{"no":338,"text":""},{"no":339,"text":"「ははは。角田さん、塩で盛り合わせ、適当に！」"},{"no":340,"text":""},{"no":341,"text":"「適当、の基準は」"},{"no":342,"text":""},{"no":343,"text":"「角田さんが、いい感じに」"},{"no":344,"text":""},{"no":345,"text":"角田は無言でうなずいて、焼き場に向かった。"},{"no":346,"text":""},{"no":347,"text":"律はノートに書いた。「基準：いい感じ（定義不能）」"},{"no":348,"text":""},{"no":349,"text":"皿が来た。"},{"no":350,"text":""},{"no":351,"text":"串は七本。ぼんじりは、二本目に入っていた。"},{"no":352,"text":""},{"no":353,"text":"「昨日の缶は、どうだった？」"},{"no":354,"text":""},{"no":355,"text":"ゆずが串を持ったまま聞いた。"},{"no":356,"text":""},{"no":357,"text":"「三口で顔が赤くなり、飲み切れずに冷蔵庫に入れました」"},{"no":358,"text":""},{"no":359,"text":"「あはは。おいしいとは思わなかった？」"},{"no":360,"text":""},{"no":361,"text":"「苦い、と思いました。おいしい、とは、記入できませんでした」"},{"no":362,"text":""},{"no":363,"text":"「そっか」"},{"no":364,"text":""},{"no":365,"text":"ゆずは串をかじって、少し笑った。"},{"no":366,"text":""},{"no":367,"text":"「あたしも最初、そうだったよ」"},{"no":368,"text":""},{"no":369,"text":"「牧野さんも、苦かったのですか」"},{"no":370,"text":""},{"no":371,"text":"「たぶん。覚えてない」"},{"no":372,"text":""},{"no":373,"text":"覚えていないのに、同じだったと言う。律はその矛盾を書き留めかけて、ペン先を止めた。"},{"no":374,"text":""},{"no":375,"text":"◇"},{"no":376,"text":""},{"no":377,"text":"十九時十五分。"},{"no":378,"text":""},{"no":379,"text":"「角田さん。途中の伝票を、見せていただけますか」"},{"no":380,"text":""},{"no":381,"text":"角田が手を止めた。"},{"no":382,"text":""},{"no":383,"text":"「まだ早い」"},{"no":384,"text":""},{"no":385,"text":"「予算は各千円までです。現在の合計を確認したいので」"},{"no":386,"text":""},{"no":387,"text":"「……ほれ」"},{"no":388,"text":""},{"no":389,"text":"小さな紙が出てきた。"},{"no":390,"text":""},{"no":391,"text":"「ミニ生　四百円」"},{"no":392,"text":""},{"no":393,"text":"「中生　六百円」"},{"no":394,"text":""},{"no":395,"text":"「盛り合わせ　九百円」"},{"no":396,"text":""},{"no":397,"text":"合計は千九百円。"},{"no":398,"text":""},{"no":399,"text":"割り勘で、一人九百五十円。予算の千円に収まっている。"},{"no":400,"text":""},{"no":401,"text":"お通しの行は、なかった。"},{"no":402,"text":""},{"no":403,"text":"「お通しの項目が、ありません」"},{"no":404,"text":""},{"no":405,"text":"「サービス」"},{"no":406,"text":""},{"no":407,"text":"「二回目の確認です」"},{"no":408,"text":""},{"no":409,"text":"「りっちゃん、何してるの」"},{"no":410,"text":""},{"no":411,"text":"ゆずが覗きこんだ。"},{"no":412,"text":""},{"no":413,"text":"「お通しの料金の有無を、書面で確認しています」"},{"no":414,"text":""},{"no":415,"text":"「サービスじゃん」"},{"no":416,"text":""},{"no":417,"text":"「口頭と書面は、別です」"},{"no":418,"text":""},{"no":419,"text":"「ほぼ同じだよ」"},{"no":420,"text":""},{"no":421,"text":"「別です」"},{"no":422,"text":""},{"no":423,"text":"ゆずはそれ以上は言わなかった。ジョッキの残りを飲み干して、手を挙げた。"},{"no":424,"text":""},{"no":425,"text":"「角田さん、中、もう一杯！」"},{"no":426,"text":""},{"no":427,"text":"「ゆずちゃん、早えな」"},{"no":428,"text":""},{"no":429,"text":"眼鏡の男が声をかけてきた。"},{"no":430,"text":""},{"no":431,"text":"「あたし、強いほうだから」"},{"no":432,"text":""},{"no":433,"text":"「ゆずちゃんは、うちの強い子だからな」"},{"no":434,"text":""},{"no":435,"text":"作業服の男も言った。"},{"no":436,"text":""},{"no":437,"text":"律はノートを開いた。"},{"no":438,"text":""},{"no":439,"text":"「牧野さん」"},{"no":440,"text":""},{"no":441,"text":"「ん？」"},{"no":442,"text":""},{"no":443,"text":"「二杯目です」"},{"no":444,"text":""},{"no":445,"text":"「あ、うん。早い？」"},{"no":446,"text":""},{"no":447,"text":"「二十分で、中ジョッキ二杯。純アルコール四十グラムです」"},{"no":448,"text":""},{"no":449,"text":"「へー」"},{"no":450,"text":""},{"no":451,"text":"「一日の目安は、二十グラムです」"},{"no":452,"text":""},{"no":453,"text":"「へー」"},{"no":454,"text":""},{"no":455,"text":"「分解は、一時間に五グラムです」"},{"no":456,"text":""},{"no":457,"text":"「へー」"},{"no":458,"text":""},{"no":459,"text":"「体重五十キロなら、です。四十グラムなら、八時間かかります」"},{"no":460,"text":""},{"no":461,"text":"ゆずの手が止まった。"},{"no":462,"text":""},{"no":463,"text":"「……ふーん」"},{"no":464,"text":""},{"no":465,"text":"それだけ言って、ジョッキに口をつけた。"},{"no":466,"text":""},{"no":467,"text":"その後、ゆずは何も言わなかった。"},{"no":468,"text":""},{"no":469,"text":"律はそれを、了承と受け取った。"},{"no":470,"text":""},{"no":471,"text":"ノートに、沈黙の欄はなかった。"},{"no":472,"text":""},{"no":473,"text":"「じゃ、あたし、あっち挨拶してくる」"},{"no":474,"text":""},{"no":475,"text":"ゆずはジョッキを持って、三つ先の席へ移った。"},{"no":476,"text":""},{"no":477,"text":"常連の男たちが「おう」と迎えた。"},{"no":478,"text":""},{"no":479,"text":"律は一人になった。"},{"no":480,"text":""},{"no":481,"text":"ミニ生を見る。まだ三分の二ほど残っていた。"},{"no":482,"text":""},{"no":483,"text":"「……時間をかけます」"},{"no":484,"text":""},{"no":485,"text":"口の中で三秒数えて、飲む。"},{"no":486,"text":""},{"no":487,"text":"苦い。やはり苦い。"},{"no":488,"text":""},{"no":489,"text":"悪くない、とは書けなかった。好き、とも書けない。"},{"no":490,"text":""},{"no":491,"text":"「感想」の欄は、空けたままにした。"},{"no":492,"text":""},{"no":493,"text":"角田が皿を置いた。"},{"no":494,"text":""},{"no":495,"text":"つくねが二本。塩だった。"},{"no":496,"text":""},{"no":497,"text":"「誕生日。サービス」"},{"no":498,"text":""},{"no":499,"text":"律は何も聞かなかった。"},{"no":500,"text":""},{"no":501,"text":"「いただきます」"},{"no":502,"text":""},{"no":503,"text":"三度目の「サービス」には、質問が要らなかった。"},{"no":504,"text":""},{"no":505,"text":"つくねは熱く、中が柔らかかった。"},{"no":506,"text":""},{"no":507,"text":"◇"},{"no":508,"text":""},{"no":509,"text":"二十時二十分。"},{"no":510,"text":""},{"no":511,"text":"トイレは店の奥の廊下の突き当たりにあった。"},{"no":512,"text":""},{"no":513,"text":"扉の前で、律は足を止めた。"},{"no":514,"text":""},{"no":515,"text":"狭い廊下だった。壁と、扉と、半畳ぶんの床。"},{"no":516,"text":""},{"no":517,"text":"去年もこうだった。"},{"no":518,"text":""},{"no":519,"text":"学科の飲み会。律は最後まで、ウーロン茶だった。"},{"no":520,"text":""},{"no":521,"text":"トイレの前に立ったとき、壁の向こうから声がした。"},{"no":522,"text":""},{"no":523,"text":"「あの子、いると空気が教室になるよね」"},{"no":524,"text":""},{"no":525,"text":"誰の声かは、確かめていない。"},{"no":526,"text":""},{"no":527,"text":"悪口だと受け取った。誰にも言っていない。"},{"no":528,"text":""},{"no":529,"text":"律はトイレに入らず、席に戻って、ウーロン茶を最後まで飲んだ。"},{"no":530,"text":""},{"no":531,"text":"今夜の扉は白かった。"},{"no":532,"text":""},{"no":533,"text":"席に戻ると、ゆずは常連三人に挟まれていた。"},{"no":534,"text":""},{"no":535,"text":"カウンターの上に、空の徳利が一本。その横に、瓶ビール。"},{"no":536,"text":""},{"no":537,"text":"三杯目は日本酒の一合。四杯目がいま注がれている。"},{"no":538,"text":""},{"no":539,"text":"「ほれ、ゆずちゃん」"},{"no":540,"text":""},{"no":541,"text":"作業服の男が瓶を傾けた。"},{"no":542,"text":""},{"no":543,"text":"ラベルが下を向いていた。"},{"no":544,"text":""},{"no":545,"text":"「ラベルは、上です」"},{"no":546,"text":""},{"no":547,"text":"律は言った。"},{"no":548,"text":""},{"no":549,"text":"「ん？　ああ」"},{"no":550,"text":""},{"no":551,"text":"作業服の男は、ラベルを下にしたまま、注ぎ終えた。"},{"no":552,"text":""},{"no":553,"text":"帽子の男も眼鏡の男も、何も言わなかった。気にしていたのは、律だけだった。"},{"no":554,"text":""},{"no":555,"text":"「ゆずちゃん、ほら、友達の分も飲んでやれ」"},{"no":556,"text":""},{"no":557,"text":"眼鏡の男が言った。"},{"no":558,"text":""},{"no":559,"text":"「いけるいける。あたし、強いほうだから」"},{"no":560,"text":""},{"no":561,"text":"ゆずは笑った。目が細くなった。"},{"no":562,"text":""},{"no":563,"text":"グラスはあっという間に空いた。"},{"no":564,"text":""},{"no":565,"text":"「おお、強い強い」"},{"no":566,"text":""},{"no":567,"text":"「強いほうだから」"},{"no":568,"text":""},{"no":569,"text":"「牧野さん」"},{"no":570,"text":""},{"no":571,"text":"「強いほうだから」"},{"no":572,"text":""},{"no":573,"text":"「牧野さん。水を」"},{"no":574,"text":""},{"no":575,"text":"「だいじょぶ。あたし、強いほう……」"},{"no":576,"text":""},{"no":577,"text":"声が少しずつ小さくなった。"},{"no":578,"text":""},{"no":579,"text":"「強いほう、だから」"},{"no":580,"text":""},{"no":581,"text":"「強い、ほう」"},{"no":582,"text":""},{"no":583,"text":"ゴン、と音がした。"},{"no":584,"text":""},{"no":585,"text":"ゆずの頭がカウンターに置かれた。"},{"no":586,"text":""},{"no":587,"text":"「おい、ゆずちゃん」"},{"no":588,"text":""},{"no":589,"text":"「寝たな」"},{"no":590,"text":""},{"no":591,"text":"「寝たか」"},{"no":592,"text":""},{"no":593,"text":"角田が串を持った手を止めて、ゆずを見た。何も言わなかった。"},{"no":594,"text":""},{"no":595,"text":"ゆずは、動かない。"},{"no":596,"text":""},{"no":597,"text":"律は自分の席に戻った。"},{"no":598,"text":""},{"no":599,"text":"ミニ生のグラスが、まだ四割残っていた。"},{"no":600,"text":""},{"no":601,"text":"ぬるくなっていた。"},{"no":602,"text":""},{"no":603,"text":"ノートを開く。"},{"no":604,"text":""},{"no":605,"text":"「二十時五十八分」"},{"no":606,"text":""},{"no":607,"text":"「律　ミニ生　約百二十ミリリットル　純アルコール四・八グラム」"},{"no":608,"text":""},{"no":609,"text":"「ゆず　四杯　推定八十グラム（律の約十七倍）」"},{"no":610,"text":""},{"no":611,"text":"「分解に要する時間　十六時間」"},{"no":612,"text":""},{"no":613,"text":"赤い付箋を一枚はがした。"},{"no":614,"text":""},{"no":615,"text":"「強いほう　未確認」"},{"no":616,"text":""},{"no":617,"text":"ノートの端に貼る。さっき受け取った色だった。"},{"no":618,"text":""},{"no":619,"text":"その下に、もう一行足した。"},{"no":620,"text":""},{"no":621,"text":"「お通し　サービス（口頭、伝票。三回目は、聞かなかった）」"},{"no":622,"text":""},{"no":623,"text":"ページをめくる。"},{"no":624,"text":""},{"no":625,"text":"十一番目の項目だった。"},{"no":626,"text":""},{"no":627,"text":"「十一。酔った人の対応」"},{"no":628,"text":""},{"no":629,"text":"予習してきた項目だった。使わずに済めばいい、と思って書いた項目だった。"},{"no":630,"text":""},{"no":631,"text":"律は一行目を声に出して読んだ。"},{"no":632,"text":""},{"no":633,"text":"「一。横向きに寝かせる」"}],"illus":[]}