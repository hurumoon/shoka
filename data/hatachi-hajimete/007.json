{"title":"第七話　コップは半分","lines":[{"no":3,"text":"十三時。"},{"no":4,"text":""},{"no":5,"text":"実家の玄関のドアは、律が引く前に開いた。"},{"no":6,"text":""},{"no":7,"text":"母が立っていた。エプロンの紐を、前で結んでいる。"},{"no":8,"text":""},{"no":9,"text":"「ちゃんとしてる？」"},{"no":10,"text":""},{"no":11,"text":"毎週日曜に、電話で聞かれる言葉だ。顔を見て言われるのは、久しぶりだ。"},{"no":12,"text":""},{"no":13,"text":"「しています。ただいま帰りました」"},{"no":14,"text":""},{"no":15,"text":"「見れば分かるわ。お昼は」"},{"no":16,"text":""},{"no":17,"text":"「乗り換えの待ち時間に、食べました」"},{"no":18,"text":""},{"no":19,"text":"「そう。ちゃんとしてるのね」"},{"no":20,"text":""},{"no":21,"text":"廊下の奥に、父が立っている。"},{"no":22,"text":""},{"no":23,"text":"シャツのいちばん上のボタンまで留めてある。"},{"no":24,"text":""},{"no":25,"text":"眼鏡の縁は右だけ曲がったままだ。"},{"no":26,"text":""},{"no":27,"text":"「予習は、したのか」"},{"no":28,"text":""},{"no":29,"text":"どのことか、律は迷わなかった。"},{"no":30,"text":""},{"no":31,"text":"「はい」"},{"no":32,"text":""},{"no":33,"text":"「そうか」"},{"no":34,"text":""},{"no":35,"text":"それだけで、父は書斎へ戻った。扉が閉まる。"},{"no":36,"text":""},{"no":37,"text":"台所で、律は鞄から缶を出した。"},{"no":38,"text":""},{"no":39,"text":"百三十五ミリリットル、五パーセント。純アルコール量は五・四グラム。"},{"no":40,"text":""},{"no":41,"text":"コンビニの棚で、いちばん小さい缶だ。"},{"no":42,"text":""},{"no":43,"text":"「冷蔵庫の奥を、使ってもいいですか」"},{"no":44,"text":""},{"no":45,"text":"母は缶を見て、何も聞かなかった。"},{"no":46,"text":""},{"no":47,"text":"「奥ね」"},{"no":48,"text":""},{"no":49,"text":"麦茶のポットを持ち上げ、缶の手前に置き直した。"},{"no":50,"text":""},{"no":51,"text":"午後は母の隣で、里芋の皮をむいた。"},{"no":52,"text":""},{"no":53,"text":"「夕飯のあとに、お父さんと話します」"},{"no":54,"text":""},{"no":55,"text":"「何を」"},{"no":56,"text":""},{"no":57,"text":"「それは、まだ言えません。段取りは、立てました」"},{"no":58,"text":""},{"no":59,"text":"「そう。立てたのね」"},{"no":60,"text":""},{"no":61,"text":"母は剥けた里芋を、律の手から取った。"},{"no":62,"text":""},{"no":63,"text":"「段取りは、外れるものよ」"},{"no":64,"text":""},{"no":65,"text":"「承知しています。外れた分は、書き足します」"},{"no":66,"text":""},{"no":67,"text":"「そうね。あなたは、そうするわね」"},{"no":68,"text":""},{"no":69,"text":"母が小皿を取りに、食器棚の前へ立った。"},{"no":70,"text":""},{"no":71,"text":"最上段は空っぽだった。子どものころ、律が「お酒の棚」と呼んだ段だ。"},{"no":72,"text":""},{"no":73,"text":"母の手が最上段の高さまで上がって、止まる。それから、ひとつ下の段へ降りた。"},{"no":74,"text":""},{"no":75,"text":"小皿を二枚取って、母は何も言わなかった。"},{"no":76,"text":""},{"no":77,"text":"◇"},{"no":78,"text":""},{"no":79,"text":"十八時半。夕食の最後の一口が、律の皿から消えた。"},{"no":80,"text":""},{"no":81,"text":"ご飯は多めに炊いてあって、釜の底がまだ見えない。"},{"no":82,"text":""},{"no":83,"text":"「電車は、定刻だったか」"},{"no":84,"text":""},{"no":85,"text":"父が聞いた。"},{"no":86,"text":""},{"no":87,"text":"「三分遅れました。乗り換えは、予定どおりです」"},{"no":88,"text":""},{"no":89,"text":"「三分なら、許容範囲だな」"},{"no":90,"text":""},{"no":91,"text":"父は箸を置き、湯呑みを空にして立った。"},{"no":92,"text":""},{"no":93,"text":"書斎に入る。扉が閉まる。"},{"no":94,"text":""},{"no":95,"text":"予習では、切り出すのはここのはずだった。"},{"no":96,"text":""},{"no":97,"text":"父は数字で答える人だ。"},{"no":98,"text":""},{"no":99,"text":"「話があります」と言えば、「何の話だ」と返る。"},{"no":100,"text":""},{"no":101,"text":"「何分なら空いていますか」と言えば、「三十分だ」と返る。"},{"no":102,"text":""},{"no":103,"text":"後者のほうが早い。"},{"no":104,"text":""},{"no":105,"text":"律は立ち上がって、流しに向かった。"},{"no":106,"text":""},{"no":107,"text":"「洗います」"},{"no":108,"text":""},{"no":109,"text":"「いいのよ」"},{"no":110,"text":""},{"no":111,"text":"「洗います」"},{"no":112,"text":""},{"no":113,"text":"母は座り直した。"},{"no":114,"text":""},{"no":115,"text":"皿は八枚だった。洗い終えて、律は廊下へ出た。"},{"no":116,"text":""},{"no":117,"text":"書斎の前で止まる。扉の下の隙間に、細い光が見える。"},{"no":118,"text":""},{"no":119,"text":"手を上げ、ノックの形で止めた。"},{"no":120,"text":""},{"no":121,"text":"「お父さん。何分、空いて……」"},{"no":122,"text":""},{"no":123,"text":"声は扉に届く前に、小さくなった。"},{"no":124,"text":""},{"no":125,"text":"手を下ろす。"},{"no":126,"text":""},{"no":127,"text":"台所へ戻り、冷蔵庫を開けた。麦茶のポットの後ろに、缶は同じ位置にあった。"},{"no":128,"text":""},{"no":129,"text":"確認は一回で足りる。"},{"no":130,"text":""},{"no":131,"text":"「動いてないわよ」"},{"no":132,"text":""},{"no":133,"text":"母が食卓で、お茶を飲みながら言った。"},{"no":134,"text":""},{"no":135,"text":"「はい。確認しました」"},{"no":136,"text":""},{"no":137,"text":"「そう」"},{"no":138,"text":""},{"no":139,"text":"◇"},{"no":140,"text":""},{"no":141,"text":"十九時四十分。"},{"no":142,"text":""},{"no":143,"text":"書斎の扉が開いた。予習どおりだ。"},{"no":144,"text":""},{"no":145,"text":"父は毎晩この時刻に、お茶を取りに出てくる。子どものころから変わらない。"},{"no":146,"text":""},{"no":147,"text":"父は急須に湯を注ぎ、湯呑みを持って食卓に座った。"},{"no":148,"text":""},{"no":149,"text":"律は冷蔵庫から缶を出し、食卓の真ん中に置いた。"},{"no":150,"text":""},{"no":151,"text":"父の湯呑みが、口の手前で止まる。"},{"no":152,"text":""},{"no":153,"text":"「お父さん」"},{"no":154,"text":""},{"no":155,"text":"「なんだ」"},{"no":156,"text":""},{"no":157,"text":"「何分なら、空いていますか」"},{"no":158,"text":""},{"no":159,"text":"「……何の用だ」"},{"no":160,"text":""},{"no":161,"text":"三十分、という答えを予習していた。"},{"no":162,"text":""},{"no":163,"text":"外れた。"},{"no":164,"text":""},{"no":165,"text":"「一緒に、飲んでほしいのです」"},{"no":166,"text":""},{"no":167,"text":"湯呑みはまだ宙にある。"},{"no":168,"text":""},{"no":169,"text":"「……三十五」"},{"no":170,"text":""},{"no":171,"text":"「何がですか」"},{"no":172,"text":""},{"no":173,"text":"「いや」"},{"no":174,"text":""},{"no":175,"text":"父は湯呑みを置いた。指先で缶に触れ、二センチ、律のほうへ押し戻す。"},{"no":176,"text":""},{"no":177,"text":"「断る。父さんは飲めない」"},{"no":178,"text":""},{"no":179,"text":"律の手が、缶へ伸びかけて止まった。"},{"no":180,"text":""},{"no":181,"text":"膝の上に戻す。三つ数える。"},{"no":182,"text":""},{"no":183,"text":"父は答えない。湯呑みの縁を、親指でなぞっている。"},{"no":184,"text":""},{"no":185,"text":"「承知しております。承知のうえで、お願いしております」"},{"no":186,"text":""},{"no":187,"text":"「飲める量は、ゼロだ」"},{"no":188,"text":""},{"no":189,"text":"「ゼロかどうかは、確認されていません」"},{"no":190,"text":""},{"no":191,"text":"「確認の必要がない」"},{"no":192,"text":""},{"no":193,"text":"「あります」"},{"no":194,"text":""},{"no":195,"text":"「律は、もう飲んだのだろう」"},{"no":196,"text":""},{"no":197,"text":"「一杯、飲みました。一口目は苦くて、三口でやめました」"},{"no":198,"text":""},{"no":199,"text":"「それで十分だ」"},{"no":200,"text":""},{"no":201,"text":"「わたしは、十分です。お父さんの分が、まだです」"},{"no":202,"text":""},{"no":203,"text":"父の手が眼鏡の縁へ上がった。外す前に、止まる。"},{"no":204,"text":""},{"no":205,"text":"怒る前の動作だ。律は椅子の上で背を伸ばした。"},{"no":206,"text":""},{"no":207,"text":"「予習は、したのか」"},{"no":208,"text":""},{"no":209,"text":"二度目だった。"},{"no":210,"text":""},{"no":211,"text":"律は鞄に手を入れた。"},{"no":212,"text":""},{"no":213,"text":"底に、A4の紙が二枚ある。"},{"no":214,"text":""},{"no":215,"text":"純アルコール量の目安と、一時間の分解量の表。昨日、図書館で印刷した。"},{"no":216,"text":""},{"no":217,"text":"指が紙の角に触れる。"},{"no":218,"text":""},{"no":219,"text":"出せば、父は読む。最後まで読んで、数字で答える。"},{"no":220,"text":""},{"no":221,"text":"その先の予習はできていない。"},{"no":222,"text":""},{"no":223,"text":"指を抜いた。"},{"no":224,"text":""},{"no":225,"text":"「しました。見せるほどでは、ありません」"},{"no":226,"text":""},{"no":227,"text":"「見せるほどでは、ない」"},{"no":228,"text":""},{"no":229,"text":"父が繰り返した。"},{"no":230,"text":""},{"no":231,"text":"かわりに、律はしおりを出した。最後の頁を開き、父のほうへ向ける。"},{"no":232,"text":""},{"no":233,"text":"三行だけ、書いてある。"},{"no":234,"text":""},{"no":235,"text":"「酒　量（　）　一杯を一時間　相手は『帰る』と言える人」"},{"no":236,"text":""},{"no":237,"text":"「タバコ　一口　朝六時、物干し場に立つ」"},{"no":238,"text":""},{"no":239,"text":"「パチンコ　千円　三十分　帰りは豆腐屋」"},{"no":240,"text":""},{"no":241,"text":"父は眼鏡を直し、読み始める。"},{"no":242,"text":""},{"no":243,"text":"読む速さは律と同じだった。"},{"no":244,"text":""},{"no":245,"text":"「この括弧は」"},{"no":246,"text":""},{"no":247,"text":"「空欄です。お父さんと、決めたいのです」"},{"no":248,"text":""},{"no":249,"text":"「千円で三十分か。パチンコは」"},{"no":250,"text":""},{"no":251,"text":"「はい。実際は、九分で終わりました」"},{"no":252,"text":""},{"no":253,"text":"「一分、百十一円だな」"},{"no":254,"text":""},{"no":255,"text":"「そうです」"},{"no":256,"text":""},{"no":257,"text":"「それは、なかなか、面白いな」"},{"no":258,"text":""},{"no":259,"text":"父は表を読むような顔のまま言った。"},{"no":260,"text":""},{"no":261,"text":"秒針が八回進んだ。"},{"no":262,"text":""},{"no":263,"text":"父が立ち上がった。"},{"no":264,"text":""},{"no":265,"text":"「……待っていなさい」"},{"no":266,"text":""},{"no":267,"text":"書斎の扉が開く。本棚の奥を探る、紙の擦れる音がする。"},{"no":268,"text":""},{"no":269,"text":"母が流しで手を拭いていた。いつの間にか、食卓のほうを向いている。"},{"no":270,"text":""},{"no":271,"text":"戻った父は一冊のノートを持っていた。"},{"no":272,"text":""},{"no":273,"text":"食卓に置く。"},{"no":274,"text":""},{"no":275,"text":"表紙が日に焼けて、茶色い。"},{"no":276,"text":""},{"no":277,"text":"右上に日付がある。年の数字は読めない。その下に、二文字。"},{"no":278,"text":""},{"no":279,"text":"「予習」"},{"no":280,"text":""},{"no":281,"text":"律は自分のしおりを、その隣に置いた。"},{"no":282,"text":""},{"no":283,"text":"位置も書き方も、同じだった。小学三年の日曜に教わった書式の、元の姿だ。"},{"no":284,"text":""},{"no":285,"text":"父が表紙をめくる。"},{"no":286,"text":""},{"no":287,"text":"最初の頁に、手順が四行。"},{"no":288,"text":""},{"no":289,"text":"「一　量　缶一本」"},{"no":290,"text":""},{"no":291,"text":"「二　場所　自室」"},{"no":292,"text":""},{"no":293,"text":"「三　時刻　二十時」"},{"no":294,"text":""},{"no":295,"text":"「四　予想　問題なし」"},{"no":296,"text":""},{"no":297,"text":"余白に、結果が書いてある。"},{"no":298,"text":""},{"no":299,"text":"「缶一本、四十分」"},{"no":300,"text":""},{"no":301,"text":"その横に、小さい字でもう一行。"},{"no":302,"text":""},{"no":303,"text":"「飲まないことにする」"},{"no":304,"text":""},{"no":305,"text":"「声に出すな」"},{"no":306,"text":""},{"no":307,"text":"読み上げていた。"},{"no":308,"text":""},{"no":309,"text":"「癖です」"},{"no":310,"text":""},{"no":311,"text":"「知っている」"},{"no":312,"text":""},{"no":313,"text":"父は律のほうを見なかった。"},{"no":314,"text":""},{"no":315,"text":"「二十歳の誕生日だ」"},{"no":316,"text":""},{"no":317,"text":"父が言った。"},{"no":318,"text":""},{"no":319,"text":"「父さんの場合は、缶一本で、四十分だな」"},{"no":320,"text":""},{"no":321,"text":"「予想の欄は『問題なし』ですね」"},{"no":322,"text":""},{"no":323,"text":"「外れた」"},{"no":324,"text":""},{"no":325,"text":"「わたしも外れました。余白に、書き足しています」"},{"no":326,"text":""},{"no":327,"text":"「そうか」"},{"no":328,"text":""},{"no":329,"text":"父は小さく息を吐いた。"},{"no":330,"text":""},{"no":331,"text":"「同じ書き方だな」"},{"no":332,"text":""},{"no":333,"text":"次の頁を、父がめくる。"},{"no":334,"text":""},{"no":335,"text":"鉛筆で、見出しが一行だけ。"},{"no":336,"text":""},{"no":337,"text":"「次の予習　未定」"},{"no":338,"text":""},{"no":339,"text":"その下は白い。次の頁も白い。"},{"no":340,"text":""},{"no":341,"text":"最後の頁まで、全部白かった。"},{"no":342,"text":""},{"no":343,"text":"三十五年ぶんの白紙だ。"},{"no":344,"text":""},{"no":345,"text":"結果欄の下の余白に、もう一行あった。"},{"no":346,"text":""},{"no":347,"text":"インクの色が違う。青だ。"},{"no":348,"text":""},{"no":349,"text":"「六月十一日　律、三歳　駅前の店　入る　十分で出る」"},{"no":350,"text":""},{"no":351,"text":"律は読んで、止まった。"},{"no":352,"text":""},{"no":353,"text":"「あの日は」の続きが、そこにあった。"},{"no":354,"text":""},{"no":355,"text":"母の視線がその行に落ちた。落ちて、すぐ湯呑みへ戻った。"},{"no":356,"text":""},{"no":357,"text":"父は何も言わない。"},{"no":358,"text":""},{"no":359,"text":"缶に手を伸ばした。さっき押し戻した二センチを、同じ二センチ、引き寄せる。"},{"no":360,"text":""},{"no":361,"text":"「律」"},{"no":362,"text":""},{"no":363,"text":"「はい」"},{"no":364,"text":""},{"no":365,"text":"「コップは、半分でいい」"},{"no":366,"text":""},{"no":367,"text":"「理由を、うかがっても」"},{"no":368,"text":""},{"no":369,"text":"「寝たとき、律は運べんだろう」"},{"no":370,"text":""},{"no":371,"text":"「運べません。毛布で足りますか」"},{"no":372,"text":""},{"no":373,"text":"「足りる」"},{"no":374,"text":""},{"no":375,"text":"母が食器棚の前に、踏み台を引いてきた。"},{"no":376,"text":""},{"no":377,"text":"のぼる。最上段の奥へ、腕を入れた。"},{"no":378,"text":""},{"no":379,"text":"出てきたのは、新聞紙の包みだった。黄ばんで、紙がぱりぱり鳴る。"},{"no":380,"text":""},{"no":381,"text":"「結婚祝いよ。一度も、使っていないの」"},{"no":382,"text":""},{"no":383,"text":"母が父を見た。"},{"no":384,"text":""},{"no":385,"text":"「あなたが捨てなかったから、奥にあったのよ」"},{"no":386,"text":""},{"no":387,"text":"「……そうだな」"},{"no":388,"text":""},{"no":389,"text":"包みを開くと、小さなグラスが二つ出た。"},{"no":390,"text":""},{"no":391,"text":"脚がなく、手のひらに収まる。縁に金の細い線がある。"},{"no":392,"text":""},{"no":393,"text":"母が洗って、布巾で拭いた。"},{"no":394,"text":""},{"no":395,"text":"食器棚の最上段は、空っぽになった。"},{"no":396,"text":""},{"no":397,"text":"◇"},{"no":398,"text":""},{"no":399,"text":"二十時三十四分。"},{"no":400,"text":""},{"no":401,"text":"グラスが二つ、食卓に並んだ。"},{"no":402,"text":""},{"no":403,"text":"母が水のコップも二つ置いた。"},{"no":404,"text":""},{"no":405,"text":"「規則の二です」"},{"no":406,"text":""},{"no":407,"text":"律が言う。"},{"no":408,"text":""},{"no":409,"text":"「水を挟みます」"},{"no":410,"text":""},{"no":411,"text":"「いい規則だ」"},{"no":412,"text":""},{"no":413,"text":"父が缶を開ける。プシュ。"},{"no":414,"text":""},{"no":415,"text":"絵柄の面を上にして、傾けた。"},{"no":416,"text":""},{"no":417,"text":"「ラベルは、上だったな」"},{"no":418,"text":""},{"no":419,"text":"「はい」"},{"no":420,"text":""},{"no":421,"text":"「昔、予習した」"},{"no":422,"text":""},{"no":423,"text":"泡が立った。"},{"no":424,"text":""},{"no":425,"text":"父は缶を起こして、落ちるのを待つ。もう一度傾けて、グラスの半分で止める。"},{"no":426,"text":""},{"no":427,"text":"「約六十ミリリットルです」"},{"no":428,"text":""},{"no":429,"text":"律は言った。"},{"no":430,"text":""},{"no":431,"text":"「純アルコール量は、二・四グラム」"},{"no":432,"text":""},{"no":433,"text":"「少ないな」"},{"no":434,"text":""},{"no":435,"text":"「想定内です」"},{"no":436,"text":""},{"no":437,"text":"二つめも同じ高さで止めた。缶の底に、十五ミリリットルほど残った。"},{"no":438,"text":""},{"no":439,"text":"律はグラスを持った。"},{"no":440,"text":""},{"no":441,"text":"予習どおり、相手より低く出す。"},{"no":442,"text":""},{"no":443,"text":"父のグラスも、低く出てきた。"},{"no":444,"text":""},{"no":445,"text":"二つのグラスは、同じ高さで止まった。"},{"no":446,"text":""},{"no":447,"text":"「乾杯」"},{"no":448,"text":""},{"no":449,"text":"「乾杯」"},{"no":450,"text":""},{"no":451,"text":"小さな音がした。"},{"no":452,"text":""},{"no":453,"text":"「律」"},{"no":454,"text":""},{"no":455,"text":"「はい」"},{"no":456,"text":""},{"no":457,"text":"「二十歳、おめでとう。八日遅れだな」"},{"no":458,"text":""},{"no":459,"text":"「はい。八日です」"},{"no":460,"text":""},{"no":461,"text":"「許容範囲にしておく」"},{"no":462,"text":""},{"no":463,"text":"母が見ていた。"},{"no":464,"text":""},{"no":465,"text":"一口目は苦かった。顔は赤くならない。"},{"no":466,"text":""},{"no":467,"text":"父は両手でグラスを持ち、少しずつ飲んでいる。"},{"no":468,"text":""},{"no":469,"text":"「一杯を、一時間だったな」"},{"no":470,"text":""},{"no":471,"text":"「はい。いま、八分です」"},{"no":472,"text":""},{"no":473,"text":"「長いな」"},{"no":474,"text":""},{"no":475,"text":"「長いです」"},{"no":476,"text":""},{"no":477,"text":"「苦いな」"},{"no":478,"text":""},{"no":479,"text":"「はい」"},{"no":480,"text":""},{"no":481,"text":"「三十五年前と、同じだ」"},{"no":482,"text":""},{"no":483,"text":"母が急須を持ってきた。"},{"no":484,"text":""},{"no":485,"text":"「ふたつしかないのよ」"},{"no":486,"text":""},{"no":487,"text":"自分の湯呑みにだけ、お茶を注いだ。"},{"no":488,"text":""},{"no":489,"text":"「タバコは」"},{"no":490,"text":""},{"no":491,"text":"父が聞いた。"},{"no":492,"text":""},{"no":493,"text":"「一口で十分でした。咳は五回出ました」"},{"no":494,"text":""},{"no":495,"text":"「そうか」"},{"no":496,"text":""},{"no":497,"text":"「灰皿は、買いません」"},{"no":498,"text":""},{"no":499,"text":"「家にも置かん」"},{"no":500,"text":""},{"no":501,"text":"「存じています」"},{"no":502,"text":""},{"no":503,"text":"律は腕時計を見た。"},{"no":504,"text":""},{"no":505,"text":"二十一時十三分。"},{"no":506,"text":""},{"no":507,"text":"父の耳が赤い。"},{"no":508,"text":""},{"no":509,"text":"「……四十分だな」"},{"no":510,"text":""},{"no":511,"text":"「はい。計っています」"},{"no":512,"text":""},{"no":513,"text":"「予習どおりだ」"},{"no":514,"text":""},{"no":515,"text":"父の眼鏡が鼻の先まで下がった。"},{"no":516,"text":""},{"no":517,"text":"頭がゆっくり傾く。"},{"no":518,"text":""},{"no":519,"text":"母がうしろから手を伸ばし、眼鏡を外した。折りたたんで、食卓の端に置く。"},{"no":520,"text":""},{"no":521,"text":"二十一時十四分。"},{"no":522,"text":""},{"no":523,"text":"四十分ちょうどだった。"},{"no":524,"text":""},{"no":525,"text":"「お風呂、先に入りなさい」"},{"no":526,"text":""},{"no":527,"text":"母が小声で言った。"},{"no":528,"text":""},{"no":529,"text":"「お父さんを、このままに」"},{"no":530,"text":""},{"no":531,"text":"「毛布をかけるから、いいのよ」"},{"no":532,"text":""},{"no":533,"text":"「四十分で、起きません」"},{"no":534,"text":""},{"no":535,"text":"「それも、予習なの」"},{"no":536,"text":""},{"no":537,"text":"「いえ。今のは、確認です」"},{"no":538,"text":""},{"no":539,"text":"母が毛布を持ってきて、父の肩にかけた。"},{"no":540,"text":""},{"no":541,"text":"母は毛布の端を直した。"},{"no":542,"text":""},{"no":543,"text":"律はしおりの最後の頁を開いた。"},{"no":544,"text":""},{"no":545,"text":"括弧の中に、書き入れる。"},{"no":546,"text":""},{"no":547,"text":"「酒　量（コップ半分）　一杯を一時間　相手は『帰る』と言える人」"},{"no":548,"text":""},{"no":549,"text":"その下に、新しい行を足した。"},{"no":550,"text":""},{"no":551,"text":"「コップ半分　約六十ミリリットル　純アルコール二・四グラム」"},{"no":552,"text":""},{"no":553,"text":"「二十時三十四分〜二十一時十四分　父が眠るまで　四十分」"},{"no":554,"text":""},{"no":555,"text":"「父の返事　予想『三十分』　実際『何の用だ』」"},{"no":556,"text":""},{"no":557,"text":"「未定　勝った日の決まり。来週の日曜」"},{"no":558,"text":""},{"no":559,"text":"最後の行は、ペンが少し止まってから動いた。"},{"no":560,"text":""},{"no":561,"text":"「予習は、やめない。余白を、先に作っておく」"},{"no":562,"text":""},{"no":563,"text":"頁の下に、余白が三行ぶん残っていた。"},{"no":564,"text":""},{"no":565,"text":"◇"},{"no":566,"text":""},{"no":567,"text":"翌朝、五時五十八分。"},{"no":568,"text":""},{"no":569,"text":"実家の庭に、物干し竿がある。律はその前に立っていた。"},{"no":570,"text":""},{"no":571,"text":"煙のにおいはしない。"},{"no":572,"text":""},{"no":573,"text":"風上も風下もない。三メートル離れる相手もいない。"},{"no":574,"text":""},{"no":575,"text":"それでも六時には立つ。決めてある。"},{"no":576,"text":""},{"no":577,"text":"勝手口が開く。"},{"no":578,"text":""},{"no":579,"text":"父だった。"},{"no":580,"text":""},{"no":581,"text":"寝癖が右にはねている。眼鏡の縁を指で押し上げて、庭に降りてくる。"},{"no":582,"text":""},{"no":583,"text":"「早いな」"},{"no":584,"text":""},{"no":585,"text":"「六時です。立つと決めています」"},{"no":586,"text":""},{"no":587,"text":"「何を待っている」"},{"no":588,"text":""},{"no":589,"text":"「何も。立つだけです」"},{"no":590,"text":""},{"no":591,"text":"父は何かを数えるような顔をした。"},{"no":592,"text":""},{"no":593,"text":"それから、冗談の顔になった。"},{"no":594,"text":""},{"no":595,"text":"「予習は、したのか」"},{"no":596,"text":""},{"no":597,"text":"三度目だった。"},{"no":598,"text":""},{"no":599,"text":"「いいえ。今日は、していません」"},{"no":600,"text":""},{"no":601,"text":"「そうか」"},{"no":602,"text":""},{"no":603,"text":"父は少し笑って、竿の端に手を置いた。"},{"no":604,"text":""},{"no":605,"text":"「何割だ」"},{"no":606,"text":""},{"no":607,"text":"「ゼロ割です」"},{"no":608,"text":""},{"no":609,"text":"「いい数字だな」"},{"no":610,"text":""},{"no":611,"text":"「今日は祝日です。勤労感謝の日です」"},{"no":612,"text":""},{"no":613,"text":"「勤労か」"},{"no":614,"text":""},{"no":615,"text":"父は庭の土を見た。"},{"no":616,"text":""},{"no":617,"text":"「半日、寝ていたな」"},{"no":618,"text":""},{"no":619,"text":"「八時間四十六分です。二十一時十四分から、六時まで」"},{"no":620,"text":""},{"no":621,"text":"「数えていたのか」"},{"no":622,"text":""},{"no":623,"text":"「数えました」"},{"no":624,"text":""},{"no":625,"text":"母が洗濯かごを抱えて、勝手口から出てきた。"},{"no":626,"text":""},{"no":627,"text":"「二人とも、手伝いなさい」"},{"no":628,"text":""},{"no":629,"text":"律はシャツを受け取り、竿に掛けた。父も一枚掛けた。"},{"no":630,"text":""},{"no":631,"text":"竿に二枚、並んだ。どちらも、いちばん上のボタンまで留まっている。"},{"no":632,"text":""},{"no":633,"text":"「ご飯、多めに炊いてあるわよ」"},{"no":634,"text":""},{"no":635,"text":"釜の底は朝になってもまだ見えなかった。"}],"illus":[]}