{"title":"第四話　やめとけの朝","lines":[{"no":3,"text":"日曜、二十時。"},{"no":4,"text":""},{"no":5,"text":"二〇二号室の机で、スマホが鳴った。"},{"no":6,"text":""},{"no":7,"text":"画面には「母」と出ている。第一声は決まっている。"},{"no":8,"text":""},{"no":9,"text":"『ちゃんとしてる？』"},{"no":10,"text":""},{"no":11,"text":"「しています」"},{"no":12,"text":""},{"no":13,"text":"『そう。お父さんに代わるわね』"},{"no":14,"text":""},{"no":15,"text":"衣擦れの音がした。"},{"no":16,"text":""},{"no":17,"text":"律は背筋を伸ばした。電話でも伸ばす。"},{"no":18,"text":""},{"no":19,"text":"『予習は、したのか』"},{"no":20,"text":""},{"no":21,"text":"父の声は低くて、平らだった。"},{"no":22,"text":""},{"no":23,"text":"「しました」"},{"no":24,"text":""},{"no":25,"text":"『結果は』"},{"no":26,"text":""},{"no":27,"text":"数字で返す。それが書式だ。"},{"no":28,"text":""},{"no":29,"text":"「三分の一です」"},{"no":30,"text":""},{"no":31,"text":"『三割三分だな』"},{"no":32,"text":""},{"no":33,"text":"「はい」"},{"no":34,"text":""},{"no":35,"text":"『残りは』"},{"no":36,"text":""},{"no":37,"text":"「今週中に、終わらせます」"},{"no":38,"text":""},{"no":39,"text":"『そうか』"},{"no":40,"text":""},{"no":41,"text":"通話は五十秒で切れた。"},{"no":42,"text":""},{"no":43,"text":"父は声だけで、人に点をつける。"},{"no":44,"text":""},{"no":45,"text":"いまの声は何点だったのか。"},{"no":46,"text":""},{"no":47,"text":"聞き返す書式は、ノートにない。"},{"no":48,"text":""},{"no":49,"text":"ノートを開く。"},{"no":50,"text":""},{"no":51,"text":"「二十時〇二分　実家　五十秒」"},{"no":52,"text":""},{"no":53,"text":"「残り二項目。タバコ、パチンコ」"},{"no":54,"text":""},{"no":55,"text":"◇"},{"no":56,"text":""},{"no":57,"text":"二十一時四十分。"},{"no":58,"text":""},{"no":59,"text":"コンビニの自動ドアは、零時のときと同じ音で開いた。"},{"no":60,"text":""},{"no":61,"text":"レジに谷口がいた。うなずき方で、誕生日のレシートを切った人だと分かる。"},{"no":62,"text":""},{"no":63,"text":"律はまっすぐレジへ進んだ。"},{"no":64,"text":""},{"no":65,"text":"銘柄選びの頁は暗記してある。候補は三つ。"},{"no":66,"text":""},{"no":67,"text":"値段も、箱に書かれた数字も覚えている。"},{"no":68,"text":""},{"no":69,"text":"「ハルカゼの、六ミリを一つください」"},{"no":70,"text":""},{"no":71,"text":"「ハルカゼは、番号です」"},{"no":72,"text":""},{"no":73,"text":"「番号」"},{"no":74,"text":""},{"no":75,"text":"谷口がレジの後ろの棚を指さした。"},{"no":76,"text":""},{"no":77,"text":"品名はどこにもなかった。小さな数字の札が、縦横に並んでいるだけだ。"},{"no":78,"text":""},{"no":79,"text":"「予習では、品名で頼むことになっていました」"},{"no":80,"text":""},{"no":81,"text":"「棚には出てないんですよ。四十二番です」"},{"no":82,"text":""},{"no":83,"text":"「よんじゅうに、ばん」"},{"no":84,"text":""},{"no":85,"text":"「はい」"},{"no":86,"text":""},{"no":87,"text":"「四十二番」"},{"no":88,"text":""},{"no":89,"text":"律は当選番号を読み上げる声で言った。"},{"no":90,"text":""},{"no":91,"text":"谷口は、賞品を渡す顔で箱を出した。"},{"no":92,"text":""},{"no":93,"text":"「番号は、覚えておくものですか」"},{"no":94,"text":""},{"no":95,"text":"「二回目からは、みなさん覚えますね」"},{"no":96,"text":""},{"no":97,"text":"「では、四十二番を暗記します」"},{"no":98,"text":""},{"no":99,"text":"「……お好きに」"},{"no":100,"text":""},{"no":101,"text":"「画面の年齢確認を、押してください」"},{"no":102,"text":""},{"no":103,"text":"「承知しております。二十歳です」"},{"no":104,"text":""},{"no":105,"text":"ピッ。"},{"no":106,"text":""},{"no":107,"text":"「六百三十円です」"},{"no":108,"text":""},{"no":109,"text":"「ライターもお願いします」"},{"no":110,"text":""},{"no":111,"text":"「百円です」"},{"no":112,"text":""},{"no":113,"text":"「合計七百三十円。予算の千円以内です」"},{"no":114,"text":""},{"no":115,"text":"「……そうですか」"},{"no":116,"text":""},{"no":117,"text":"店の外の街灯の下で、箱の側面を読んだ。"},{"no":118,"text":""},{"no":119,"text":"ニコチン〇・五ミリグラム、タール六ミリグラム。"},{"no":120,"text":""},{"no":121,"text":"予習どおりだった。"},{"no":122,"text":""},{"no":123,"text":"正面には注意書きがある。"},{"no":124,"text":""},{"no":125,"text":"「『喫煙は、あなたにとって肺がんの原因の一つとなります』」"},{"no":126,"text":""},{"no":127,"text":"声に出して読んだ。"},{"no":128,"text":""},{"no":129,"text":"「授業では、最高評価でした」"},{"no":130,"text":""},{"no":131,"text":"通りかかった自転車が、ベルを鳴らさずに避けていった。"},{"no":132,"text":""},{"no":133,"text":"実家には灰皿がなかった。父のシャツからは、チョークの粉のにおいしかしなかった。"},{"no":134,"text":""},{"no":135,"text":"箱は開けずに、コートのポケットへ入れた。開けるのは、六時だ。"},{"no":136,"text":""},{"no":137,"text":"帰り道で、番号を十一回言った。"},{"no":138,"text":""},{"no":139,"text":"四十二番。"},{"no":140,"text":""},{"no":141,"text":"覚えるのに、一回で足りた。"},{"no":142,"text":""},{"no":143,"text":"◇"},{"no":144,"text":""},{"no":145,"text":"月曜、五時五十八分。"},{"no":146,"text":""},{"no":147,"text":"コーポ若葉の裏の物干し場は、まだ暗かった。"},{"no":148,"text":""},{"no":149,"text":"ブロック塀。物干し竿が二本。足もとは砂利。"},{"no":150,"text":""},{"no":151,"text":"律は塀の前に立っていた。"},{"no":152,"text":""},{"no":153,"text":"起床は六時と決まっている。今朝は、五時に起きた。"},{"no":154,"text":""},{"no":155,"text":"就寝を二十二時半に前倒ししても、睡眠は六時間三十分。"},{"no":156,"text":""},{"no":157,"text":"基準を割った。"},{"no":158,"text":""},{"no":159,"text":"貼り紙の九時は知っている。"},{"no":160,"text":""},{"no":161,"text":"点検の三時間前なら、立ち会いと重ならない。想定内だ。"},{"no":162,"text":""},{"no":163,"text":"風向きも確かめてある。北西から。"},{"no":164,"text":""},{"no":165,"text":"立つ位置は、宇田川の風上に三メートル。"},{"no":166,"text":""},{"no":167,"text":"六時ちょうどに、裏口が開いた。"},{"no":168,"text":""},{"no":169,"text":"紺の作業ベストにサンダル。宇田川だった。"},{"no":170,"text":""},{"no":171,"text":"宇田川は律を見て止まった。"},{"no":172,"text":""},{"no":173,"text":"「あんた、何してる」"},{"no":174,"text":""},{"no":175,"text":"「立っています」"},{"no":176,"text":""},{"no":177,"text":"「やめとけ」"},{"no":178,"text":""},{"no":179,"text":"「まだ何もしていません」"},{"no":180,"text":""},{"no":181,"text":"宇田川はベストから箱を出し、火をつけた。"},{"no":182,"text":""},{"no":183,"text":"煙は律と反対へ流れた。予習のとおりだ。"},{"no":184,"text":""},{"no":185,"text":"においは、毎朝、窓の下から上がってくるものと同じだった。"},{"no":186,"text":""},{"no":187,"text":"「七番。住環境」"},{"no":188,"text":""},{"no":189,"text":"律は小声で言った。"},{"no":190,"text":""},{"no":191,"text":"「何だ」"},{"no":192,"text":""},{"no":193,"text":"「窓の下のにおいの、原因です。確認できました」"},{"no":194,"text":""},{"no":195,"text":"「……二〇二か」"},{"no":196,"text":""},{"no":197,"text":"「はい」"},{"no":198,"text":""},{"no":199,"text":"「知ってる」"},{"no":200,"text":""},{"no":201,"text":"宇田川は、吸い終えるまでそれきり言わなかった。"},{"no":202,"text":""},{"no":203,"text":"六時七分。吸い殻をベストから出した白い紙に包み、同じポケットへ戻した。"},{"no":204,"text":""},{"no":205,"text":"物干し場に、灰皿はなかった。"},{"no":206,"text":""},{"no":207,"text":"宇田川はそこで、家に戻らなかった。"},{"no":208,"text":""},{"no":209,"text":"塀に沿って歩き、外壁を手のひらで叩く。"},{"no":210,"text":""},{"no":211,"text":"ときどきしゃがんで、目地を指でなぞる。点検の下見らしい。"},{"no":212,"text":""},{"no":213,"text":"律は動かなかった。"},{"no":214,"text":""},{"no":215,"text":"六時二十分。"},{"no":216,"text":""},{"no":217,"text":"指先が白くなってきた。気温は十度。"},{"no":218,"text":""},{"no":219,"text":"想定内だが、手袋は想定外だった。"},{"no":220,"text":""},{"no":221,"text":"宇田川が律の前を通った。"},{"no":222,"text":""},{"no":223,"text":"「帰れ」"},{"no":224,"text":""},{"no":225,"text":"「帰りません」"},{"no":226,"text":""},{"no":227,"text":"「寒い」"},{"no":228,"text":""},{"no":229,"text":"「寒いです。十度です」"},{"no":230,"text":""},{"no":231,"text":"宇田川はまた塀のほうへ歩いていった。"},{"no":232,"text":""},{"no":233,"text":"六時三十分。"},{"no":234,"text":""},{"no":235,"text":"律の口が動いている。点火の手順を、小声で復習していた。"},{"no":236,"text":""},{"no":237,"text":"「……五、風向きの確認。六、」"},{"no":238,"text":""},{"no":239,"text":"「声に出てる」"},{"no":240,"text":""},{"no":241,"text":"「失礼しました」"},{"no":242,"text":""},{"no":243,"text":"「しゃべるなら、でかい声で言え」"},{"no":244,"text":""},{"no":245,"text":"「承知しました。六、風向きの再確認」"},{"no":246,"text":""},{"no":247,"text":"宇田川は返事をしなかった。肩が一度だけ、揺れた。"},{"no":248,"text":""},{"no":249,"text":"六時三十五分。"},{"no":250,"text":""},{"no":251,"text":"「宇田川さん」"},{"no":252,"text":""},{"no":253,"text":"宇田川が手を止めた。"},{"no":254,"text":""},{"no":255,"text":"「一本、いただけますか」"},{"no":256,"text":""},{"no":257,"text":"「やめとけ」"},{"no":258,"text":""},{"no":259,"text":"「お断りします」"},{"no":260,"text":""},{"no":261,"text":"宇田川の眉が上がった。"},{"no":262,"text":""},{"no":263,"text":"「二十歳です。十一月十四日に、なりました」"},{"no":264,"text":""},{"no":265,"text":"「聞いてない」"},{"no":266,"text":""},{"no":267,"text":"「いま、お伝えしました」"},{"no":268,"text":""},{"no":269,"text":"宇田川は黙って、ベストの箱から一本を抜いた。"},{"no":270,"text":""},{"no":271,"text":"「買ってあります」"},{"no":272,"text":""},{"no":273,"text":"律はポケットから、自分の箱を出した。"},{"no":274,"text":""},{"no":275,"text":"「開けるな」"},{"no":276,"text":""},{"no":277,"text":"「なぜですか」"},{"no":278,"text":""},{"no":279,"text":"「開けたら、残る」"},{"no":280,"text":""},{"no":281,"text":"「残りますか」"},{"no":282,"text":""},{"no":283,"text":"「残ったら、吸う」"},{"no":284,"text":""},{"no":285,"text":"律は箱をしまった。未開封のまま。"},{"no":286,"text":""},{"no":287,"text":"一本を受け取る。"},{"no":288,"text":""},{"no":289,"text":"親指と人差し指と中指で挟む。鉛筆を持つ形だった。"},{"no":290,"text":""},{"no":291,"text":"百円ライターも出す。"},{"no":292,"text":""},{"no":293,"text":"「点火の手順を、確認します」"},{"no":294,"text":""},{"no":295,"text":"「……ああ」"},{"no":296,"text":""},{"no":297,"text":"「一。フィルターを、唇で軽くはさむ」"},{"no":298,"text":""},{"no":299,"text":"宇田川は手を後ろに組んで待った。"},{"no":300,"text":""},{"no":301,"text":"「二。火を、先端から一センチ離して点ける」"},{"no":302,"text":""},{"no":303,"text":"「三。軽く吸いながら、火を近づける」"},{"no":304,"text":""},{"no":305,"text":"「四。先端が赤くなったら、火を離す」"},{"no":306,"text":""},{"no":307,"text":"「長いな」"},{"no":308,"text":""},{"no":309,"text":"「十一項目あります」"},{"no":310,"text":""},{"no":311,"text":"「いい。つけろ」"},{"no":312,"text":""},{"no":313,"text":"「五と六は、風向きの確認です」"},{"no":314,"text":""},{"no":315,"text":"「つけろ」"},{"no":316,"text":""},{"no":317,"text":"律は唇でフィルターをはさんだ。"},{"no":318,"text":""},{"no":319,"text":"ライターを一センチ離して、点ける。"},{"no":320,"text":""},{"no":321,"text":"吸いながら、近づける。"},{"no":322,"text":""},{"no":323,"text":"先端が赤くなった。"},{"no":324,"text":""},{"no":325,"text":"「七。煙は肺に入れず、口の中にためる」"},{"no":326,"text":""},{"no":327,"text":"ためた。"},{"no":328,"text":""},{"no":329,"text":"ためた煙がのどに落ちた。"},{"no":330,"text":""},{"no":331,"text":"咳が出た。"},{"no":332,"text":""},{"no":333,"text":"体が折れる。三回、四回。"},{"no":334,"text":""},{"no":335,"text":"目に水がたまる。"},{"no":336,"text":""},{"no":337,"text":"予習の欄には、「むせる確率　低」と書いてあった。"},{"no":338,"text":""},{"no":339,"text":"「か、感想を、手帳に」"},{"no":340,"text":""},{"no":341,"text":"「出すな」"},{"no":342,"text":""},{"no":343,"text":"宇田川の手が律の背中に伸びた。"},{"no":344,"text":""},{"no":345,"text":"届く前に、止まった。"},{"no":346,"text":""},{"no":347,"text":"宇田川は笑わなかった。手を下ろして、ベストの脇で握った。"},{"no":348,"text":""},{"no":349,"text":"「やめとけ」"},{"no":350,"text":""},{"no":351,"text":"「……熱い、です。のどに、落ちます」"},{"no":352,"text":""},{"no":353,"text":"「だろうな」"},{"no":354,"text":""},{"no":355,"text":"「予習では、むせる確率は低でした」"},{"no":356,"text":""},{"no":357,"text":"「誰が決めた」"},{"no":358,"text":""},{"no":359,"text":"「わたしです」"},{"no":360,"text":""},{"no":361,"text":"「そうか」"},{"no":362,"text":""},{"no":363,"text":"律は火のついた一本を、鉛筆の持ち方のまま握っていた。"},{"no":364,"text":""},{"no":365,"text":"吸いかけの先から、灰が伸びていく。"},{"no":366,"text":""},{"no":367,"text":"六時四十分。"},{"no":368,"text":""},{"no":369,"text":"砂利を踏む音が、建物の脇から来た。"},{"no":370,"text":""},{"no":371,"text":"◇"},{"no":372,"text":""},{"no":373,"text":"宇田川が振り向いた。"},{"no":374,"text":""},{"no":375,"text":"顔の色が変わった。"},{"no":376,"text":""},{"no":377,"text":"「よこせ」"},{"no":378,"text":""},{"no":379,"text":"小声だった。宇田川の指が、律の手の一本をつまむ。"},{"no":380,"text":""},{"no":381,"text":"足音のほうが、早かった。"},{"no":382,"text":""},{"no":383,"text":"建物の角から、女の人が出てくる。"},{"no":384,"text":""},{"no":385,"text":"四十代後半。ダウンのジャケットに、黒いリュック。"},{"no":386,"text":""},{"no":387,"text":"「お父さん、いる？」"},{"no":388,"text":""},{"no":389,"text":"宇田川は動けなかった。火のついた一本を、自分の指でつまんだまま。"},{"no":390,"text":""},{"no":391,"text":"ポケットに入れれば燃える位置だった。"},{"no":392,"text":""},{"no":393,"text":"投げれば、娘の足もとに落ちる。"},{"no":394,"text":""},{"no":395,"text":"宇田川の指は一本を持ったまま、止まっている。"},{"no":396,"text":""},{"no":397,"text":"律の足が一歩出た。"},{"no":398,"text":""},{"no":399,"text":"宇田川の指から、一本を抜き取った。"},{"no":400,"text":""},{"no":401,"text":"「わたしのです」"},{"no":402,"text":""},{"no":403,"text":"図書館のカウンターで、返却期限を言うときの声だった。"},{"no":404,"text":""},{"no":405,"text":"律は、人に嘘を言ったことがなかった。返却の日付を、一日もごまかしたことがない。"},{"no":406,"text":""},{"no":407,"text":"いま言ったことは、一語も事実に反していない。"},{"no":408,"text":""},{"no":409,"text":"それでも嘘だと、律は知っていた。"},{"no":410,"text":""},{"no":411,"text":"娘が足を止めた。"},{"no":412,"text":""},{"no":413,"text":"「……あなたは」"},{"no":414,"text":""},{"no":415,"text":"「二〇二号室の、篠原律です」"},{"no":416,"text":""},{"no":417,"text":"娘は律の顔を見た。それから、手を見た。"},{"no":418,"text":""},{"no":419,"text":"親指と人差し指と中指。鉛筆の持ち方だった。"},{"no":420,"text":""},{"no":421,"text":"娘は小さく息をついた。"},{"no":422,"text":""},{"no":423,"text":"「お父さんは、そんな持ち方、しないものね」"},{"no":424,"text":""},{"no":425,"text":"「……ああ」"},{"no":426,"text":""},{"no":427,"text":"「去年、やめたんです。お医者さんに言われて。ねえ」"},{"no":428,"text":""},{"no":429,"text":"「ああ」"},{"no":430,"text":""},{"no":431,"text":"宇田川は娘と目を合わせなかった。"},{"no":432,"text":""},{"no":433,"text":"「いつから吸ってるの？」"},{"no":434,"text":""},{"no":435,"text":"「今朝からです」"},{"no":436,"text":""},{"no":437,"text":"「今朝」"},{"no":438,"text":""},{"no":439,"text":"「五分前に、一口」"},{"no":440,"text":""},{"no":441,"text":"「……一口」"},{"no":442,"text":""},{"no":443,"text":"娘の口もとが少しゆるんだ。"},{"no":444,"text":""},{"no":445,"text":"「ですから、ここでは吸わないでください」"},{"no":446,"text":""},{"no":447,"text":"「はい。申し訳ありません」"},{"no":448,"text":""},{"no":449,"text":"「いえ。若い方に、強くは言えないけど」"},{"no":450,"text":""},{"no":451,"text":"娘はリュックを肩に掛け直した。"},{"no":452,"text":""},{"no":453,"text":"「午後から仕事が入ったの。点検の前に、お父さんの様子を見にきたのよ。早かったでしょう」"},{"no":454,"text":""},{"no":455,"text":"「……ああ」"},{"no":456,"text":""},{"no":457,"text":"「脚立、出しておいて。九時の前に、下の段から見ておきましょう」"},{"no":458,"text":""},{"no":459,"text":"「分かった」"},{"no":460,"text":""},{"no":461,"text":"「じゃあ、表にいるから」"},{"no":462,"text":""},{"no":463,"text":"砂利の音が建物の脇へ遠ざかっていく。"},{"no":464,"text":""},{"no":465,"text":"足音が消えて、律は自分の手を見た。"},{"no":466,"text":""},{"no":467,"text":"一本を持つ指が、小刻みに揺れていた。"},{"no":468,"text":""},{"no":469,"text":"◇"},{"no":470,"text":""},{"no":471,"text":"宇田川が咳払いをした。"},{"no":472,"text":""},{"no":473,"text":"「……いや」"},{"no":474,"text":""},{"no":475,"text":"そこで止まった。"},{"no":476,"text":""},{"no":477,"text":"律の手は、まだ揺れていた。"},{"no":478,"text":""},{"no":479,"text":"「震えてる」"},{"no":480,"text":""},{"no":481,"text":"「寒さです」"},{"no":482,"text":""},{"no":483,"text":"「ちがう」"},{"no":484,"text":""},{"no":485,"text":"「……想定外です」"},{"no":486,"text":""},{"no":487,"text":"宇田川は、それ以上言わなかった。"},{"no":488,"text":""},{"no":489,"text":"「お返しします」"},{"no":490,"text":""},{"no":491,"text":"律は火のついた一本を、宇田川の前へ出した。"},{"no":492,"text":""},{"no":493,"text":"宇田川は受け取り、一口吸った。"},{"no":494,"text":""},{"no":495,"text":"煙を、律と反対に吐く。"},{"no":496,"text":""},{"no":497,"text":"「それは、今朝の二本目では」"},{"no":498,"text":""},{"no":499,"text":"「……ああ」"},{"no":500,"text":""},{"no":501,"text":"「医者の決めた本数は」"},{"no":502,"text":""},{"no":503,"text":"「一本だ」"},{"no":504,"text":""},{"no":505,"text":"「超過です」"},{"no":506,"text":""},{"no":507,"text":"「分かってる」"},{"no":508,"text":""},{"no":509,"text":"宇田川はもう一度、娘の消えた角を見た。"},{"no":510,"text":""},{"no":511,"text":"「あんた」"},{"no":512,"text":""},{"no":513,"text":"「はい」"},{"no":514,"text":""},{"no":515,"text":"「嘘は、嫌いだろう」"},{"no":516,"text":""},{"no":517,"text":"「はい」"},{"no":518,"text":""},{"no":519,"text":"「……すまん」"},{"no":520,"text":""},{"no":521,"text":"「嘘ではありません。受け取ったのは、わたしです」"},{"no":522,"text":""},{"no":523,"text":"「そうか」"},{"no":524,"text":""},{"no":525,"text":"宇田川はベストから、白い紙を出した。"},{"no":526,"text":""},{"no":527,"text":"「その紙は」"},{"no":528,"text":""},{"no":529,"text":"「吸い殻は包む。現場に灰皿はなかった」"},{"no":530,"text":""},{"no":531,"text":"「落とした場所に、においが残るからですか」"},{"no":532,"text":""},{"no":533,"text":"「癖だ」"},{"no":534,"text":""},{"no":535,"text":"宇田川が紙を握り直す。"},{"no":536,"text":""},{"no":537,"text":"「いつから、ですか」"},{"no":538,"text":""},{"no":539,"text":"「四十年」"},{"no":540,"text":""},{"no":541,"text":"「四十年、毎日」"},{"no":542,"text":""},{"no":543,"text":"「毎日だ」"},{"no":544,"text":""},{"no":545,"text":"「娘さんは」"},{"no":546,"text":""},{"no":547,"text":"「……いや」"},{"no":548,"text":""},{"no":549,"text":"また止まった。律は、それ以上は聞かなかった。"},{"no":550,"text":""},{"no":551,"text":"「朝六時なのは、なぜですか」"},{"no":552,"text":""},{"no":553,"text":"「朝礼だ」"},{"no":554,"text":""},{"no":555,"text":"「朝礼の前、ですか」"},{"no":556,"text":""},{"no":557,"text":"「工務店の。朝礼の前の十分だ」"},{"no":558,"text":""},{"no":559,"text":"「みなさん、吸っていたのですか」"},{"no":560,"text":""},{"no":561,"text":"「親方も先輩も。誰も口をきかん」"},{"no":562,"text":""},{"no":563,"text":"宇田川は、指の間の一本を見た。"},{"no":564,"text":""},{"no":565,"text":"「その十分が、よかった」"},{"no":566,"text":""},{"no":567,"text":"「いまは、朝礼はありません」"},{"no":568,"text":""},{"no":569,"text":"「ない。足が、勝手に来る」"},{"no":570,"text":""},{"no":571,"text":"宇田川は、一本をブロック塀に押しつけた。"},{"no":572,"text":""},{"no":573,"text":"半分も、吸っていなかった。"},{"no":574,"text":""},{"no":575,"text":"口が動いた。"},{"no":576,"text":""},{"no":577,"text":"『やめとけ』"},{"no":578,"text":""},{"no":579,"text":"声は出なかった。"},{"no":580,"text":""},{"no":581,"text":"塀のほうを向いて、口の形だけで言った。律にしか見えない向きだった。"},{"no":582,"text":""},{"no":583,"text":"宇田川は半分の吸い殻を、白い紙に包んだ。ベストのポケットに入れる。"},{"no":584,"text":""},{"no":585,"text":"「宇田川さん」"},{"no":586,"text":""},{"no":587,"text":"「ああ」"},{"no":588,"text":""},{"no":589,"text":"「タバコは、一口で十分でした」"},{"no":590,"text":""},{"no":591,"text":"「そうか」"},{"no":592,"text":""},{"no":593,"text":"「ですが、朝六時にここへ立つのは、続けたいです」"},{"no":594,"text":""},{"no":595,"text":"宇田川は、ポケットの上から紙の包みを押さえた。"},{"no":596,"text":""},{"no":597,"text":"「……明日も来るか」"},{"no":598,"text":""},{"no":599,"text":"「来ます」"},{"no":600,"text":""},{"no":601,"text":"「そうか」"},{"no":602,"text":""},{"no":603,"text":"宇田川は背を向けて、裏口へ歩き出した。"},{"no":604,"text":""},{"no":605,"text":"三歩目で、声がした。"},{"no":606,"text":""},{"no":607,"text":"「火曜と金曜」"},{"no":608,"text":""},{"no":609,"text":"「はい？」"},{"no":610,"text":""},{"no":611,"text":"「パチンコだ。十時。小宮山って常連がいる」"},{"no":612,"text":""},{"no":613,"text":"「どうして、ご存じなのですか」"},{"no":614,"text":""},{"no":615,"text":"「商店街の工事で、知った」"},{"no":616,"text":""},{"no":617,"text":"裏口の戸が閉まった。"},{"no":618,"text":""},{"no":619,"text":"◇"},{"no":620,"text":""},{"no":621,"text":"七時十分。二〇二号室。"},{"no":622,"text":""},{"no":623,"text":"律はコートを着たまま、ノートを開いた。"},{"no":624,"text":""},{"no":625,"text":"「十六日（月）五時五十八分〜六時五十二分」"},{"no":626,"text":""},{"no":627,"text":"「一口目　熱い。のどに落ちる。咳五回（予想の欄は、むせない）」"},{"no":628,"text":""},{"no":629,"text":"「一箱　六百三十円（ライター別、百円）」"},{"no":630,"text":""},{"no":631,"text":"「ニコチン〇・五ミリグラム、タール六ミリグラム（箱の側面）」"},{"no":632,"text":""},{"no":633,"text":"「宇田川さんと立っていた時間　五十四分」"},{"no":634,"text":""},{"no":635,"text":"「宇田川さん　二本目（医者の本数を一本超過）」"},{"no":636,"text":""},{"no":637,"text":"箱は、机の引き出しに入れた。未開封のまま。"},{"no":638,"text":""},{"no":639,"text":"もう一行、書こうとした。"},{"no":640,"text":""},{"no":641,"text":"「嘘のあとの、手」"},{"no":642,"text":""},{"no":643,"text":"ペン先が揺れた。"},{"no":644,"text":""},{"no":645,"text":"「手」の縦線が、ノートの罫線をはみ出した。"},{"no":646,"text":""},{"no":647,"text":"予習の書式に、この欄はなかった。"}],"illus":[]}