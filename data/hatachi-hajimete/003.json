{"title":"第三話　ゆずさん","lines":[{"no":3,"text":"二十一時二分。"},{"no":4,"text":""},{"no":5,"text":"律は三つ先の席まで歩いた。"},{"no":6,"text":""},{"no":7,"text":"ゆずは頭をカウンターに置いたまま、動かない。頬に、木目の跡がついていた。"},{"no":8,"text":""},{"no":9,"text":"ノートの十一番を開く。"},{"no":10,"text":""},{"no":11,"text":"「呼びかけて、反応を見る」"},{"no":12,"text":""},{"no":13,"text":"「ま」"},{"no":14,"text":""},{"no":15,"text":"最初の一音で、止まった。"},{"no":16,"text":""},{"no":17,"text":"常連の三人は「ゆずちゃん」と呼ぶ。角田は「ゆず」と呼ぶ。"},{"no":18,"text":""},{"no":19,"text":"「牧野さん」と呼ぶ人は、この店で律だけだった。"},{"no":20,"text":""},{"no":21,"text":"「ゆ」"},{"no":22,"text":""},{"no":23,"text":"それも止まった。呼び捨てには、口が動かない。"},{"no":24,"text":""},{"no":25,"text":"「……あの」"},{"no":26,"text":""},{"no":27,"text":"名前を抜いて、肩に手を置いた。"},{"no":28,"text":""},{"no":29,"text":"「んー」"},{"no":30,"text":""},{"no":31,"text":"ゆずの手が上がり、ひらひら動いて、落ちた。"},{"no":32,"text":""},{"no":33,"text":"律は腕時計を見て、呼吸を一分間数える。"},{"no":34,"text":""},{"no":35,"text":"十六回。規則的だった。"},{"no":36,"text":""},{"no":37,"text":"ノートに書く。「反応あり。呼吸十六回」"},{"no":38,"text":""},{"no":39,"text":"「寝かしといてやれ」"},{"no":40,"text":""},{"no":41,"text":"作業服の男が言った。"},{"no":42,"text":""},{"no":43,"text":"「最後は、だいたいこうなる」"},{"no":44,"text":""},{"no":45,"text":"眼鏡の男も言った。"},{"no":46,"text":""},{"no":47,"text":"「強いんだけどな」"},{"no":48,"text":""},{"no":49,"text":"誰も疑っていなかった。"},{"no":50,"text":""},{"no":51,"text":"「座敷をお借りできますか。横向きに寝かせます」"},{"no":52,"text":""},{"no":53,"text":"角田が奥の座敷を見て、うなずいた。"},{"no":54,"text":""},{"no":55,"text":"「ゆずさん」と呼びたかった。今度は声が出ない。"},{"no":56,"text":""},{"no":57,"text":"代わりに、肩をもう一度揺する。"},{"no":58,"text":""},{"no":59,"text":"「移動します。横向きに寝てください」"},{"no":60,"text":""},{"no":61,"text":"「……やだ」"},{"no":62,"text":""},{"no":63,"text":"ゆずの顔が上がった。"},{"no":64,"text":""},{"no":65,"text":"「寝たくない」"},{"no":66,"text":""},{"no":67,"text":"「理由を、伺っても」"},{"no":68,"text":""},{"no":69,"text":"「寝たくない」"},{"no":70,"text":""},{"no":71,"text":"理由は、ふわっとさえしていなかった。"},{"no":72,"text":""},{"no":73,"text":"「ゆずちゃん、最後に一杯だけいっとくか」"},{"no":74,"text":""},{"no":75,"text":"作業服の男が徳利を持った。"},{"no":76,"text":""},{"no":77,"text":"「いけるいける」"},{"no":78,"text":""},{"no":79,"text":"ゆずは言った。声は、いけるとは言っていなかった。"},{"no":80,"text":""},{"no":81,"text":"律はノートの余白に書いた。「十一の一　不採用（本人が拒否）」"},{"no":82,"text":""},{"no":83,"text":"拒否の欄は、予習になかった。"},{"no":84,"text":""},{"no":85,"text":"口の中に、「帰りましょう」が用意できていた。"},{"no":86,"text":""},{"no":87,"text":"言えば、ゆずは「いいよ」と答えるだろう。"},{"no":88,"text":""},{"no":89,"text":"今夜のゆずは、律が何を言っても、常連が何を勧めても、「いいよ」か「いけるいける」だった。"},{"no":90,"text":""},{"no":91,"text":"その続きに律が一つ足しても、ゆずが決めたことにはならない。"},{"no":92,"text":""},{"no":93,"text":"律は口を閉じた。"},{"no":94,"text":""},{"no":95,"text":"「お会計を、お願いします」"},{"no":96,"text":""},{"no":97,"text":"「ゆずの分もか」"},{"no":98,"text":""},{"no":99,"text":"「はい。立て替えます」"},{"no":100,"text":""},{"no":101,"text":"角田は伝票を見て、電卓を叩いた。"},{"no":102,"text":""},{"no":103,"text":"「二千五百」"},{"no":104,"text":""},{"no":105,"text":"「あちらの徳利と瓶は」"},{"no":106,"text":""},{"no":107,"text":"「あっちで持つ。引いて、その額だ」"},{"no":108,"text":""},{"no":109,"text":"三人の男が、手を挙げた。"},{"no":110,"text":""},{"no":111,"text":"予算は千円。"},{"no":112,"text":""},{"no":113,"text":"二千五百円は、律の分とゆずの分で半分ずつだった。"},{"no":114,"text":""},{"no":115,"text":"自分の分だけで千二百五十円。二百五十円の超過だ。"},{"no":116,"text":""},{"no":117,"text":"釣りは出ない。ちょうどを払う。"},{"no":118,"text":""},{"no":119,"text":"角田が水のコップを二つ置く。一つはゆずの前に、一つは律の前に。"},{"no":120,"text":""},{"no":121,"text":"何も言わなかった。"},{"no":122,"text":""},{"no":123,"text":"律はゆずの隣に座った。"},{"no":124,"text":""},{"no":125,"text":"「帰りますか」"},{"no":126,"text":""},{"no":127,"text":"ゆずのまぶたが動いた。"},{"no":128,"text":""},{"no":129,"text":"「それとも、まだいますか。会計は済みました。どちらでも、わたしは付き合います」"},{"no":130,"text":""},{"no":131,"text":"「……いる」"},{"no":132,"text":""},{"no":133,"text":"ゆずは言った。"},{"no":134,"text":""},{"no":135,"text":"「いる。だって、あたし、強いほうだから」"},{"no":136,"text":""},{"no":137,"text":"「そうですか」"},{"no":138,"text":""},{"no":139,"text":"律は待った。"},{"no":140,"text":""},{"no":141,"text":"ゆずは水のコップを見ていた。"},{"no":142,"text":""},{"no":143,"text":"それから作業服の男の徳利を見た。"},{"no":144,"text":""},{"no":145,"text":"それから、律を見た。"},{"no":146,"text":""},{"no":147,"text":"何も予習していない待ち方だった。ノートは閉じていた。"},{"no":148,"text":""},{"no":149,"text":"一分、二分。"},{"no":150,"text":""},{"no":151,"text":"壁の時計の秒針が、きっちり一周する。"},{"no":152,"text":""},{"no":153,"text":"「……今日は、帰る」"},{"no":154,"text":""},{"no":155,"text":"ゆずが言った。"},{"no":156,"text":""},{"no":157,"text":"「うん。帰る。ごめん」"},{"no":158,"text":""},{"no":159,"text":"「おう」"},{"no":160,"text":""},{"no":161,"text":"作業服の男が徳利を下げた。"},{"no":162,"text":""},{"no":163,"text":"「気をつけてな」"},{"no":164,"text":""},{"no":165,"text":"「またな、ゆずちゃん」"},{"no":166,"text":""},{"no":167,"text":"あっさりだった。引き止める声は、一つもなかった。"},{"no":168,"text":""},{"no":169,"text":"「姉ちゃん、家は知ってんのか」"},{"no":170,"text":""},{"no":171,"text":"眼鏡の男が聞いた。"},{"no":172,"text":""},{"no":173,"text":"「南口の住宅街と聞いています。詳しくは『あっち』と」"},{"no":174,"text":""},{"no":175,"text":"「小学校の裏だ。青い屋根」"},{"no":176,"text":""},{"no":177,"text":"「ありがとうございます」"},{"no":178,"text":""},{"no":179,"text":"律は椅子から降りて、ゆずの脇に腕を入れた。"},{"no":180,"text":""},{"no":181,"text":"足がもつれる。それでも、立った。"},{"no":182,"text":""},{"no":183,"text":"トートバッグを肩にかける。"},{"no":184,"text":""},{"no":185,"text":"重い。"},{"no":186,"text":""},{"no":187,"text":"レシートとハンカチと鍵で、この重さにはならない。"},{"no":188,"text":""},{"no":189,"text":"「ありがとうございました」"},{"no":190,"text":""},{"no":191,"text":"律が言うと、角田が串を返す手を止めずに、うなずいた。"},{"no":192,"text":""},{"no":193,"text":"◇"},{"no":194,"text":""},{"no":195,"text":"二十一時四十分。"},{"no":196,"text":""},{"no":197,"text":"ゆずの家は、駅の南側にある。律は自由通路を歩いた。"},{"no":198,"text":""},{"no":199,"text":"「まっすぐ歩けますか」"},{"no":200,"text":""},{"no":201,"text":"「歩ける。ほら」"},{"no":202,"text":""},{"no":203,"text":"ゆずは柱に向かって、まっすぐ歩いた。"},{"no":204,"text":""},{"no":205,"text":"柱は動かなかった。"},{"no":206,"text":""},{"no":207,"text":"「……ごめん」"},{"no":208,"text":""},{"no":209,"text":"「いえ。柱の位置は、予習していませんでした」"},{"no":210,"text":""},{"no":211,"text":"改札の上をくぐり、南口のロータリーに出る。ゆずが立ち止まった。"},{"no":212,"text":""},{"no":213,"text":"「ここ、座る」"},{"no":214,"text":""},{"no":215,"text":"「はい」"},{"no":216,"text":""},{"no":217,"text":"ベンチは三人掛けだった。"},{"no":218,"text":""},{"no":219,"text":"座面の間に、肘掛けが二つ。横になれない作りだ。"},{"no":220,"text":""},{"no":221,"text":"律はゆずを座らせ、自分も隣に座った。"},{"no":222,"text":""},{"no":223,"text":"ノートを膝で開く。"},{"no":224,"text":""},{"no":225,"text":"「二。一人にしない」"},{"no":226,"text":""},{"no":227,"text":"「いるじゃん、りっちゃん」"},{"no":228,"text":""},{"no":229,"text":"「はい。実行中です」"},{"no":230,"text":""},{"no":231,"text":"「三。吐き気があれば、横向きで」"},{"no":232,"text":""},{"no":233,"text":"「ない。だいじょぶ」"},{"no":234,"text":""},{"no":235,"text":"「四。体を冷やさない」"},{"no":236,"text":""},{"no":237,"text":"「あっつい。だいじょぶ」"},{"no":238,"text":""},{"no":239,"text":"「五。お名前と、今日の日付を」"},{"no":240,"text":""},{"no":241,"text":"「牧野ゆず。十一月十四日。りっちゃんの誕生日」"},{"no":242,"text":""},{"no":243,"text":"全問正解だった。"},{"no":244,"text":""},{"no":245,"text":"律は「十一の一　ベンチは肘掛けつき。横になれない」と書き足した。足したのは、これだけだった。"},{"no":246,"text":""},{"no":247,"text":"「水、飲めば醒めるっしょ」"},{"no":248,"text":""},{"no":249,"text":"ゆずが言った。"},{"no":250,"text":""},{"no":251,"text":"醒めない。"},{"no":252,"text":""},{"no":253,"text":"分解は肝臓の仕事で、水に手伝えることはない。水が防ぐのは、脱水だけだ。"},{"no":254,"text":""},{"no":255,"text":"律は口を開いた。"},{"no":256,"text":""},{"no":257,"text":"閉じた。"},{"no":258,"text":""},{"no":259,"text":"「……買ってきます」"},{"no":260,"text":""},{"no":261,"text":"「だいじょぶ。ここいる」"},{"no":262,"text":""},{"no":263,"text":"「動かないでください。コンビニまで、十五歩です」"},{"no":264,"text":""},{"no":265,"text":"「動かないー」"},{"no":266,"text":""},{"no":267,"text":"往復で三十歩。ベンチはガラス越しに見えた。"},{"no":268,"text":""},{"no":269,"text":"律は店に入り、冷蔵ケースから五百ミリリットルの水を取った。百三十円。"},{"no":270,"text":""},{"no":271,"text":"レジの店員は若い男で、谷口ではなかった。"},{"no":272,"text":""},{"no":273,"text":"律は画面の年齢確認に指を出しかけて、引っ込めた。水に確認は要らない。"},{"no":274,"text":""},{"no":275,"text":"ベンチでは、ゆずが手を振っていた。"},{"no":276,"text":""},{"no":277,"text":"律も手を上げかけて、ペットボトルを持っていたことを思い出した。"},{"no":278,"text":""},{"no":279,"text":"「冷たいです。少しずつ」"},{"no":280,"text":""},{"no":281,"text":"ゆずはキャップを開け、のどを三回動かした。"},{"no":282,"text":""},{"no":283,"text":"水が半分消えた。ジョッキと同じ速さだった。"},{"no":284,"text":""},{"no":285,"text":"「あと、持ってて」"},{"no":286,"text":""},{"no":287,"text":"ボトルが律に戻ってきた。残りは二百五十ミリリットル。"},{"no":288,"text":""},{"no":289,"text":"ゆずはトートバッグを膝に乗せて、中に腕を入れた。のど飴を探す手つきだった。"},{"no":290,"text":""},{"no":291,"text":"レシート。ハンカチ。鍵。"},{"no":292,"text":""},{"no":293,"text":"その下から、紙の束が出てきた。"},{"no":294,"text":""},{"no":295,"text":"厚さは三センチほどあった。いちばん上は「二次会のご案内」。その下に、学科の飲み会、サークルの鍋、ゼミ合宿のしおり。どれも折り目がつき、日付に丸がしてある。"},{"no":296,"text":""},{"no":297,"text":"束の上に、黄色い付箋が貼ってあった。"},{"no":298,"text":""},{"no":299,"text":"「休」"},{"no":300,"text":""},{"no":301,"text":"一文字だけ書いてある。次の線は、書きかけで止まっていた。"},{"no":302,"text":""},{"no":303,"text":"律は見た。"},{"no":304,"text":""},{"no":305,"text":"ゆずと目が合った。"},{"no":306,"text":""},{"no":307,"text":"手のひらで、紙の束をバッグの底へ押し戻した。ふたをするような手つきだった。"},{"no":308,"text":""},{"no":309,"text":"「あった、のど飴」"},{"no":310,"text":""},{"no":311,"text":"ゆずは飴を口に入れた。"},{"no":312,"text":""},{"no":313,"text":"「りっちゃんも、食べる？」"},{"no":314,"text":""},{"no":315,"text":"もう一粒、差し出された。"},{"no":316,"text":""},{"no":317,"text":"「成分表示を、確認してもいいですか」"},{"no":318,"text":""},{"no":319,"text":"「のど飴だよ」"},{"no":320,"text":""},{"no":321,"text":"「確認します」"},{"no":322,"text":""},{"no":323,"text":"包みの裏を読む。"},{"no":324,"text":""},{"no":325,"text":"はちみつ、ハーブエキス、ミント。"},{"no":326,"text":""},{"no":327,"text":"アルコールは入っていない。"},{"no":328,"text":""},{"no":329,"text":"「いただきます」"},{"no":330,"text":""},{"no":331,"text":"舌の上が涼しかった。"},{"no":332,"text":""},{"no":333,"text":"ノートに手を伸ばして、ペン先を止める。この欄はない。"},{"no":334,"text":""},{"no":335,"text":"ロータリーでバスが一台、ドアを開けて、閉める。"},{"no":336,"text":""},{"no":337,"text":"「去年さ」"},{"no":338,"text":""},{"no":339,"text":"ゆずは前を向いたまま言った。"},{"no":340,"text":""},{"no":341,"text":"「飲み会で、りっちゃん、最後までウーロン茶だったじゃん」"},{"no":342,"text":""},{"no":343,"text":"「はい。十九時から二十二時四十分までです」"},{"no":344,"text":""},{"no":345,"text":"「覚えてるんだ」"},{"no":346,"text":""},{"no":347,"text":"「記録しているので」"},{"no":348,"text":""},{"no":349,"text":"「あたしあのとき、言ったんだよね」"},{"no":350,"text":""},{"no":351,"text":"飴が頬で動いた。"},{"no":352,"text":""},{"no":353,"text":"「りっちゃんいると、空気が教室になるよね、って」"},{"no":354,"text":""},{"no":355,"text":"律はボトルを持ったまま動かなかった。"},{"no":356,"text":""},{"no":357,"text":"「ほっとする、って続けたんだけど」"},{"no":358,"text":""},{"no":359,"text":"ゆずは笑った。"},{"no":360,"text":""},{"no":361,"text":"「みんな、次の話してた」"},{"no":362,"text":""},{"no":363,"text":"律はトイレの前に立っていた。壁の向こうの声は、そこで終わっていた。"},{"no":364,"text":""},{"no":365,"text":"終わってなどいなかった。続きがあった。"},{"no":366,"text":""},{"no":367,"text":"律はその続きを聞く前に、席へ戻っていた。"},{"no":368,"text":""},{"no":369,"text":"「聞こえていました」"},{"no":370,"text":""},{"no":371,"text":"「え」"},{"no":372,"text":""},{"no":373,"text":"「トイレの前で。『教室になるよね』までです」"},{"no":374,"text":""},{"no":375,"text":"ゆずが固まった。"},{"no":376,"text":""},{"no":377,"text":"三秒。飴も止まっている。"},{"no":378,"text":""},{"no":379,"text":"「……そこまで？」"},{"no":380,"text":""},{"no":381,"text":"「そこまでです」"},{"no":382,"text":""},{"no":383,"text":"「いちばん悪いとこで、切れてんじゃん」"},{"no":384,"text":""},{"no":385,"text":"ゆずは体を折って笑った。ベンチが揺れた。"},{"no":386,"text":""},{"no":387,"text":"飴が飛び出して、律の靴の前に転がった。"},{"no":388,"text":""},{"no":389,"text":"「ごめん。ごめんね、りっちゃん。嫌だったよね」"},{"no":390,"text":""},{"no":391,"text":"「いえ」"},{"no":392,"text":""},{"no":393,"text":"「ほんとにごめん」"},{"no":394,"text":""},{"no":395,"text":"「続きの確認が取れました。問題はありません」"},{"no":396,"text":""},{"no":397,"text":"「問題ないの？」"},{"no":398,"text":""},{"no":399,"text":"「ありません」"},{"no":400,"text":""},{"no":401,"text":"笑い続けるゆずの隣で、律の肩が一センチ下がった。"},{"no":402,"text":""},{"no":403,"text":"背もたれに、背中がついた。今夜はじめてだった。"},{"no":404,"text":""},{"no":405,"text":"「りっちゃんってさ、断るとき、迷わないよね」"},{"no":406,"text":""},{"no":407,"text":"「迷っています。迷ったまま、断るだけです」"},{"no":408,"text":""},{"no":409,"text":"「え、そうなの」"},{"no":410,"text":""},{"no":411,"text":"「はい。『準備ができていないので』と言うまでに、三日かかることもあります」"},{"no":412,"text":""},{"no":413,"text":"「三日」"},{"no":414,"text":""},{"no":415,"text":"「三日です」"},{"no":416,"text":""},{"no":417,"text":"「もう一つ、確認があります」"},{"no":418,"text":""},{"no":419,"text":"「なに」"},{"no":420,"text":""},{"no":421,"text":"「呼び方を、変えたいのですが」"},{"no":422,"text":""},{"no":423,"text":"「いいよ別に」"},{"no":424,"text":""},{"no":425,"text":"「では。……ゆず、ゆずざん」"},{"no":426,"text":""},{"no":427,"text":"「ざん？」"},{"no":428,"text":""},{"no":429,"text":"「訂正します。ゆず、ざ」"},{"no":430,"text":""},{"no":431,"text":"「あはは。もう、お腹痛い」"},{"no":432,"text":""},{"no":433,"text":"ゆずはベンチの背に頭を預けて、空を見た。"},{"no":434,"text":""},{"no":435,"text":"足もとの飴は、そのままにした。"},{"no":436,"text":""},{"no":437,"text":"◇"},{"no":438,"text":""},{"no":439,"text":"二十二時二十五分。"},{"no":440,"text":""},{"no":441,"text":"ゆずの家は、南口から歩いて八分の、二階建てだった。"},{"no":442,"text":""},{"no":443,"text":"玄関の灯りの下に、小柄な女性が立っていた。"},{"no":444,"text":""},{"no":445,"text":"「ゆず」"},{"no":446,"text":""},{"no":447,"text":"「ただいまー」"},{"no":448,"text":""},{"no":449,"text":"ゆずの声は、角ふくよりずっと小さかった。"},{"no":450,"text":""},{"no":451,"text":"「篠原律です。同期です。お送りしました」"},{"no":452,"text":""},{"no":453,"text":"「律ちゃんね。ゆずから聞いてるわ。ごめんなさい、重かったでしょう」"},{"no":454,"text":""},{"no":455,"text":"「いえ。鞄のほうが重かったです」"},{"no":456,"text":""},{"no":457,"text":"母はトートバッグを受け取る。手で持ち上げて、重さを確かめる。"},{"no":458,"text":""},{"no":459,"text":"そのまま、何も聞かない。"},{"no":460,"text":""},{"no":461,"text":"「飲酒量は、中ジョッキ二杯、日本酒一合、瓶ビール一杯です。純アルコールで八十グラムです」"},{"no":462,"text":""},{"no":463,"text":"「……四杯」"},{"no":464,"text":""},{"no":465,"text":"母はゆずを見た。"},{"no":466,"text":""},{"no":467,"text":"「この子が。ジョッキ一杯でも、赤くなるのに」"},{"no":468,"text":""},{"no":469,"text":"「お母さん、言わないでよ」"},{"no":470,"text":""},{"no":471,"text":"ゆずは玄関の段に座り込んだ。靴の紐を解くふりをして、解かなかった。"},{"no":472,"text":""},{"no":473,"text":"「律ちゃん、お茶でも飲んでいって」"},{"no":474,"text":""},{"no":475,"text":"「ありがとうございます。就寝が二十三時ですので」"},{"no":476,"text":""},{"no":477,"text":"「あら、もうそんな時間」"},{"no":478,"text":""},{"no":479,"text":"「帰宅に十二分かかります。ぎりぎりです」"},{"no":480,"text":""},{"no":481,"text":"「りっちゃん」"},{"no":482,"text":""},{"no":483,"text":"「はい」"},{"no":484,"text":""},{"no":485,"text":"「また行こ」"},{"no":486,"text":""},{"no":487,"text":"「はい」"},{"no":488,"text":""},{"no":489,"text":"「水で」"},{"no":490,"text":""},{"no":491,"text":"「水で、ですか」"},{"no":492,"text":""},{"no":493,"text":"「水で。角ふくで」"},{"no":494,"text":""},{"no":495,"text":"律はノートに手を伸ばしかけて、やめた。"},{"no":496,"text":""},{"no":497,"text":"「水の本数は、事前に決めておきます」"},{"no":498,"text":""},{"no":499,"text":"「決めなくていいよ」"},{"no":500,"text":""},{"no":501,"text":"「では、現地で確認します」"},{"no":502,"text":""},{"no":503,"text":"「そっちのほうが、いい」"},{"no":504,"text":""},{"no":505,"text":"ゆずは笑って、手を振った。"},{"no":506,"text":""},{"no":507,"text":"「おやすみ、りっちゃん」"},{"no":508,"text":""},{"no":509,"text":"「ゆずさん、おやすみなさい」"},{"no":510,"text":""},{"no":511,"text":"言えた。"},{"no":512,"text":""},{"no":513,"text":"一度でだ。"},{"no":514,"text":""},{"no":515,"text":"律は自分の口を確かめた。もう一度言うと、噛みそうだった。"},{"no":516,"text":""},{"no":517,"text":"玄関の戸が閉まった。"},{"no":518,"text":""},{"no":519,"text":"◇"},{"no":520,"text":""},{"no":521,"text":"二十二時三十分。"},{"no":522,"text":""},{"no":523,"text":"帰り道、律は残りの水を歩きながら飲んだ。"},{"no":524,"text":""},{"no":525,"text":"ぬるい。"},{"no":526,"text":""},{"no":527,"text":"三口めで、ゆずが口をつけたボトルだと気づいた。予習にない項目だった。"},{"no":528,"text":""},{"no":529,"text":"十分ほど歩いて、コーポ若葉の前を通る。一階の端の窓は、暗い。"},{"no":530,"text":""},{"no":531,"text":"◇"},{"no":532,"text":""},{"no":533,"text":"二十三時十分。"},{"no":534,"text":""},{"no":535,"text":"帰宅は二十二時四十二分だった。手洗いと歯みがきと明日の服で、二十八分かかった。"},{"no":536,"text":""},{"no":537,"text":"二〇二号室の台所で、律は冷蔵庫の前に立っていた。"},{"no":538,"text":""},{"no":539,"text":"ノートの表紙の内側から、緑のパッドを出す。"},{"no":540,"text":""},{"no":541,"text":"青は法とマナー。黄はリスクと数字。赤は未確認。"},{"no":542,"text":""},{"no":543,"text":"緑は、予習の色ではない。"},{"no":544,"text":""},{"no":545,"text":"予習が外れた夜に、律が自分で決めたことを書く色にした。"},{"no":546,"text":""},{"no":547,"text":"一枚めくり、三色ボールペンの黒で書く。"},{"no":548,"text":""},{"no":549,"text":"「一。一杯は、一時間かける」"},{"no":550,"text":""},{"no":551,"text":"「二。水を挟む」"},{"no":552,"text":""},{"no":553,"text":"「三。『帰る』と言える人と飲む」"},{"no":554,"text":""},{"no":555,"text":"三行目の「人」は、相手のことでもあり、自分のことでもあった。どちらでもよかったので、そのまま書いた。"},{"no":556,"text":""},{"no":557,"text":"冷蔵庫の扉の、目の高さに貼る。"},{"no":558,"text":""},{"no":559,"text":"扉の向こうには、二百五十ミリリットルの缶が残っている。"},{"no":560,"text":""},{"no":561,"text":"ノートを開いた。"},{"no":562,"text":""},{"no":563,"text":"「二十三時二十分」"},{"no":564,"text":""},{"no":565,"text":"「水　角ふくでコップ二杯、南口で一本（百三十円）。ゆず、半分」"},{"no":566,"text":""},{"no":567,"text":"「勘定　二千五百円（律　千二百五十円、ゆず分の立て替え　千二百五十円）」"},{"no":568,"text":""},{"no":569,"text":"「ゆず　四杯（八十グラム）。母談　ジョッキ一杯でも赤くなる」"},{"no":570,"text":""},{"no":571,"text":"「強いほう　未確認 → 訂正」"},{"no":572,"text":""},{"no":573,"text":"「呼び方　牧野さん → ゆずさん　止まる、噛む、言えた　各一回」"},{"no":574,"text":""},{"no":575,"text":"ページの端に、もう一行足した。"},{"no":576,"text":""},{"no":577,"text":"「十五日（日）二十一時四十分　コンビニ　タバコ」"},{"no":578,"text":""},{"no":579,"text":"窓の外は暗かった。六時になれば、窓の下から煙のにおいがする。"},{"no":580,"text":""},{"no":581,"text":"律は電気を消した。"},{"no":582,"text":""},{"no":583,"text":"就寝は、二十三時四十分。予定より四十分の超過だった。"}],"illus":[]}