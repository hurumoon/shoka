{"title":"第六話　千円と三十分","lines":[{"no":3,"text":"木曜の夜。"},{"no":4,"text":""},{"no":5,"text":"二〇二号室の台所で、律はタイマーを持っていた。"},{"no":6,"text":""},{"no":7,"text":"実家から持ってきた、ぜんまい式の古いものだ。母がゆで卵を三分に合わせるのに使っていた。"},{"no":8,"text":""},{"no":9,"text":"「試します」"},{"no":10,"text":""},{"no":11,"text":"つまみを、いちばん手前の目盛りに合わせる。"},{"no":12,"text":""},{"no":13,"text":"五秒後。"},{"no":14,"text":""},{"no":15,"text":"ジリリリリリリ。"},{"no":16,"text":""},{"no":17,"text":"律は肩の高さまで跳ねた。"},{"no":18,"text":""},{"no":19,"text":"想定していた音の、倍あった。"},{"no":20,"text":""},{"no":21,"text":"つまみを戻す。窓ガラスの震えが止まった。"},{"no":22,"text":""},{"no":23,"text":"「音量は、確認済みです」"},{"no":24,"text":""},{"no":25,"text":"誰も聞いていなかった。"},{"no":26,"text":""},{"no":27,"text":"緑の付箋を一枚はがし、ノートの新しい頁に貼る。"},{"no":28,"text":""},{"no":29,"text":"「一　金額　千円。封筒に入れて、封筒ごと持っていく」"},{"no":30,"text":""},{"no":31,"text":"「二　時間　三十分。台所のタイマーを、台の上に置く」"},{"no":32,"text":""},{"no":33,"text":"「三　帰り　豆腐屋」"},{"no":34,"text":""},{"no":35,"text":"数字は全部、自分で決めた。"},{"no":36,"text":""},{"no":37,"text":"千円は今月の余りから出した。三十分は、火曜の二十七分が長くも短くもなかったので丸めた。"},{"no":38,"text":""},{"no":39,"text":"サイトの数字は、一つも使っていない。"},{"no":40,"text":""},{"no":41,"text":"声に出して読む。"},{"no":42,"text":""},{"no":43,"text":"「千円。三十分。豆腐屋」"},{"no":44,"text":""},{"no":45,"text":"四行目を書こうとして、ペン先が止まった。"},{"no":46,"text":""},{"no":47,"text":"「四」"},{"no":48,"text":""},{"no":49,"text":"勝った場合は、どうするのか。"},{"no":50,"text":""},{"no":51,"text":"火曜に見た当たりは、一回だけだった。見本の顔は、笑っていなかった。"},{"no":52,"text":""},{"no":53,"text":"負けたときの予習は、三行で足りた。"},{"no":54,"text":""},{"no":55,"text":"勝ったときは、一文字も出てこない。"},{"no":56,"text":""},{"no":57,"text":"三十分、考えた。"},{"no":58,"text":""},{"no":59,"text":"タイマーは回さなかった。"},{"no":60,"text":""},{"no":61,"text":"◇"},{"no":62,"text":""},{"no":63,"text":"金曜、九時五十分。"},{"no":64,"text":""},{"no":65,"text":"パーラーひまわりの自動ドアは、閉まっていた。"},{"no":66,"text":""},{"no":67,"text":"肩かばんの内側に、茶封筒とタイマーが入っている。律は札の前に立った。"},{"no":68,"text":""},{"no":69,"text":"「おはよう、先生」"},{"no":70,"text":""},{"no":71,"text":"薄紫のカーディガンが、隣に並んだ。"},{"no":72,"text":""},{"no":73,"text":"「おはようございます」"},{"no":74,"text":""},{"no":75,"text":"「来ますって言ったの、本当に来たのね」"},{"no":76,"text":""},{"no":77,"text":"「予定表に、入れましたので」"},{"no":78,"text":""},{"no":79,"text":"「あらまあ。入れたの」"},{"no":80,"text":""},{"no":81,"text":"「はい」"},{"no":82,"text":""},{"no":83,"text":"十時。鍵が回り、ドアが滑る。"},{"no":84,"text":""},{"no":85,"text":"電子音。金属の流れる音。拡声器が割れる音。"},{"no":86,"text":""},{"no":87,"text":"律の手はコートのポケットの中にあった。"},{"no":88,"text":""},{"no":89,"text":"上がらなかった。ポケットの中で、拳を作っただけだ。"},{"no":90,"text":""},{"no":91,"text":"「今日は、手が上がらないのね」"},{"no":92,"text":""},{"no":93,"text":"「入れておきました」"},{"no":94,"text":""},{"no":95,"text":"「賢いわ」"},{"no":96,"text":""},{"no":97,"text":"トヨは奥から三台目の椅子の背を、二度叩いて座った。"},{"no":98,"text":""},{"no":99,"text":"律は四台目に座る。台の上に、表示板が並んでいる。「大当たり確率　三百分の一」。その横に、番号札。三と、四。"},{"no":100,"text":""},{"no":101,"text":"封筒から千円札を出して、右の細い口に入れた。折れ目のない札が、すっと消える。"},{"no":102,"text":""},{"no":103,"text":"次に、鞄からタイマーを出した。台のひさしの端に置き、つまみを三十分に回す。"},{"no":104,"text":""},{"no":105,"text":"十時三分。"},{"no":106,"text":""},{"no":107,"text":"「それ、なあに？」"},{"no":108,"text":""},{"no":109,"text":"「台所のタイマーです。三十分で鳴ります」"},{"no":110,"text":""},{"no":111,"text":"「あら。ばあさんより厳しいわ」"},{"no":112,"text":""},{"no":113,"text":"貸し玉のボタンを押す。皿に銀色が落ちる。"},{"no":114,"text":""},{"no":115,"text":"ハンドルを半分に回した。"},{"no":116,"text":""},{"no":117,"text":"半分の数値はない。感覚で半分にした。"},{"no":118,"text":""},{"no":119,"text":"玉は次々に飛び出していく。"},{"no":120,"text":""},{"no":121,"text":"九分後。"},{"no":122,"text":""},{"no":123,"text":"皿が空になる。画面は何も起こさない。"},{"no":124,"text":""},{"no":125,"text":"「千円が終わりました」"},{"no":126,"text":""},{"no":127,"text":"「あら、早かったのね」"},{"no":128,"text":""},{"no":129,"text":"「九分です。半分のつもりでしたが、七割くらいでした」"},{"no":130,"text":""},{"no":131,"text":"「そーっとよ、そーっと」"},{"no":132,"text":""},{"no":133,"text":"律は封筒をのぞいた。空だ。"},{"no":134,"text":""},{"no":135,"text":"追加の札を出そうにも、手は鞄に向かなかった。"},{"no":136,"text":""},{"no":137,"text":"「ここまでです」"},{"no":138,"text":""},{"no":139,"text":"「もう帰るの？」"},{"no":140,"text":""},{"no":141,"text":"「三十分、ここにいます。残りは二十一分です」"},{"no":142,"text":""},{"no":143,"text":"「あらあら」"},{"no":144,"text":""},{"no":145,"text":"「見ています」"},{"no":146,"text":""},{"no":147,"text":"「ばあさんを？」"},{"no":148,"text":""},{"no":149,"text":"「台を、です」"},{"no":150,"text":""},{"no":151,"text":"トヨはうれしそうに笑った。"},{"no":152,"text":""},{"no":153,"text":"「じゃあ、ちゃんと見てなさいな。この台はね、よく当たるのよ」"},{"no":154,"text":""},{"no":155,"text":"律は口を開けた。"},{"no":156,"text":""},{"no":157,"text":"三百分の一は、どの台も同じだ。前の当たりは、次に響かない。説明なら、十五字で足りる。"},{"no":158,"text":""},{"no":159,"text":"閉じた。"},{"no":160,"text":""},{"no":161,"text":"「そうですか」"},{"no":162,"text":""},{"no":163,"text":"「あら、先生。言いたいことがある顔ね」"},{"no":164,"text":""},{"no":165,"text":"「ありません。確認しました」"},{"no":166,"text":""},{"no":167,"text":"「何を？」"},{"no":168,"text":""},{"no":169,"text":"「そうですか、を」"},{"no":170,"text":""},{"no":171,"text":"トヨの玉は、間を置いて一つずつ飛んでいく。"},{"no":172,"text":""},{"no":173,"text":"「小宮山さんは、右手の角度が毎回同じです」"},{"no":174,"text":""},{"no":175,"text":"「そう？」"},{"no":176,"text":""},{"no":177,"text":"「手首が、ほとんど動きません」"},{"no":178,"text":""},{"no":179,"text":"「教わったのよ」"},{"no":180,"text":""},{"no":181,"text":"「どなたにですか」"},{"no":182,"text":""},{"no":183,"text":"「さあ。ずいぶん前ね」"},{"no":184,"text":""},{"no":185,"text":"トヨはそれきり、画面を見ていた。"},{"no":186,"text":""},{"no":187,"text":"律の目は、トヨの右手と、トヨの皿と、壁の時計を順に回った。"},{"no":188,"text":""},{"no":189,"text":"十時二十九分。"},{"no":190,"text":""},{"no":191,"text":"トヨの台が白く光った。"},{"no":192,"text":""},{"no":193,"text":"曲が鳴り出す。"},{"no":194,"text":""},{"no":195,"text":"ポケットの中で、律の手が縮んだ。上がらなかった。"},{"no":196,"text":""},{"no":197,"text":"「あらやだ」"},{"no":198,"text":""},{"no":199,"text":"小さな声だった。"},{"no":200,"text":""},{"no":201,"text":"トヨの右手がハンドルを離れる。首の小銭入れの紐を、左手が握った。"},{"no":202,"text":""},{"no":203,"text":"皿から玉があふれ、下の箱に落ちていく。"},{"no":204,"text":""},{"no":205,"text":"律は「おめでとうございます」を言わなかった。火曜に言って、笑ってもらえなかった。"},{"no":206,"text":""},{"no":207,"text":"曲が鳴っている間、トヨの目は、台に掛かった札の「三」にあった。"},{"no":208,"text":""},{"no":209,"text":"三分たった。"},{"no":210,"text":""},{"no":211,"text":"曲が終わる。"},{"no":212,"text":""},{"no":213,"text":"トヨの人差し指が、貸し玉のボタンへ寄っていく。"},{"no":214,"text":""},{"no":215,"text":"予定にない。律は何も言わなかった。"},{"no":216,"text":""},{"no":217,"text":"店の音が一拍引いて、二秒だけ、奥のコーナーから音が消えた。"},{"no":218,"text":""},{"no":219,"text":"その二秒に、律の台の上でタイマーが鳴った。"},{"no":220,"text":""},{"no":221,"text":"ジリリリリリリ。"},{"no":222,"text":""},{"no":223,"text":"通路にいた客が顔を上げる。景品カウンターの店員が首を伸ばす。"},{"no":224,"text":""},{"no":225,"text":"向かいの島では、老人が立って覗いた。"},{"no":226,"text":""},{"no":227,"text":"全員が、こちらを見ていた。"},{"no":228,"text":""},{"no":229,"text":"止め方は予習済みだ。つまみを戻せばいい。"},{"no":230,"text":""},{"no":231,"text":"ところが手が届かない。タイマーは鳴りながら、台のひさしの上を小刻みに歩いていく。"},{"no":232,"text":""},{"no":233,"text":"律は両手でつかみ、胸に抱えた。音がくぐもる。"},{"no":234,"text":""},{"no":235,"text":"「止まりません」"},{"no":236,"text":""},{"no":237,"text":"「先生、それ、おしまいの合図ね」"},{"no":238,"text":""},{"no":239,"text":"トヨが笑っていた。肩が揺れている。"},{"no":240,"text":""},{"no":241,"text":"「ばあさん、気づいたわ。時間なのね」"},{"no":242,"text":""},{"no":243,"text":"「三十分です」"},{"no":244,"text":""},{"no":245,"text":"「ちょうどね」"},{"no":246,"text":""},{"no":247,"text":"トヨは玉の箱を、両手で持ち上げようとした。"},{"no":248,"text":""},{"no":249,"text":"思ったより重かったらしい。足を踏み直す。"},{"no":250,"text":""},{"no":251,"text":"律はつまみを戻した。ベルが止まった。"},{"no":252,"text":""},{"no":253,"text":"トヨは箱を床に置いた。"},{"no":254,"text":""},{"no":255,"text":"立ったまま、台に掛かった札の「三」に人差し指を伸ばす。"},{"no":256,"text":""},{"no":257,"text":"なでる。一度だけ。"},{"no":258,"text":""},{"no":259,"text":"紐は、左手が握っていた。"},{"no":260,"text":""},{"no":261,"text":"それから小銭入れの口を開け、透明なカードケースを出した。"},{"no":262,"text":""},{"no":263,"text":"「景品の窓口で、出すのよ」"},{"no":264,"text":""},{"no":265,"text":"ケースの中に、会員証が入っていた。角が丸くすり切れている。"},{"no":266,"text":""},{"no":267,"text":"名前は「小宮山　実」。"},{"no":268,"text":""},{"no":269,"text":"トヨの名前ではない。"},{"no":270,"text":""},{"no":271,"text":"律は文字を読むのが速い。読めてしまった。"},{"no":272,"text":""},{"no":273,"text":"有効期限の欄は、三年前で止まっている。"},{"no":274,"text":""},{"no":275,"text":"会員証の裏に、小さな写真が重ねてあった。帽子の男の人が、椅子に座って笑っている。後ろの台の札に、「三」。"},{"no":276,"text":""},{"no":277,"text":"トヨはケースを、親指で一度なぞった。"},{"no":278,"text":""},{"no":279,"text":"何も言わない。"},{"no":280,"text":""},{"no":281,"text":"何も聞かないことにした。"},{"no":282,"text":""},{"no":283,"text":"「先生」"},{"no":284,"text":""},{"no":285,"text":"「はい」"},{"no":286,"text":""},{"no":287,"text":"「最後に一回、ここに座ってみる？」"},{"no":288,"text":""},{"no":289,"text":"トヨの手が、三台目の椅子の背に置かれている。"},{"no":290,"text":""},{"no":291,"text":"律は立っていた。"},{"no":292,"text":""},{"no":293,"text":"自分の四台目の椅子の背に、手を置いた。"},{"no":294,"text":""},{"no":295,"text":"そのまま、動かなかった。"},{"no":296,"text":""},{"no":297,"text":"一秒。"},{"no":298,"text":""},{"no":299,"text":"二秒。"},{"no":300,"text":""},{"no":301,"text":"「そうね」"},{"no":302,"text":""},{"no":303,"text":"トヨは笑って、椅子の背を二度、軽く叩いた。座るときと同じ叩き方だった。"},{"no":304,"text":""},{"no":305,"text":"◇"},{"no":306,"text":""},{"no":307,"text":"景品カウンターの機械に、玉が流れ込む。"},{"no":308,"text":""},{"no":309,"text":"二千二百。律の暗算では、二千二百円分だ。"},{"no":310,"text":""},{"no":311,"text":"暗記した景品交換の頁が、初めて目の前で動いた。見ているだけだった。"},{"no":312,"text":""},{"no":313,"text":"トヨは特殊景品を小さな袋に入れ、お菓子の詰め合わせも一つ受け取った。"},{"no":314,"text":""},{"no":315,"text":"「先生、チョコレート。半分こ」"},{"no":316,"text":""},{"no":317,"text":"「いただけません」"},{"no":318,"text":""},{"no":319,"text":"「ばあさんは、もらってほしいの」"},{"no":320,"text":""},{"no":321,"text":"「……いただきます」"},{"no":322,"text":""},{"no":323,"text":"同じ袋から、トヨはカウンターの店員にも一つ、向かいの島の老人にも一つ配った。"},{"no":324,"text":""},{"no":325,"text":"「さっきの、鳴ったやつか」"},{"no":326,"text":""},{"no":327,"text":"老人が律を見た。"},{"no":328,"text":""},{"no":329,"text":"「わたしのです」"},{"no":330,"text":""},{"no":331,"text":"「……いい音だった」"},{"no":332,"text":""},{"no":333,"text":"「ありがとうございます」"},{"no":334,"text":""},{"no":335,"text":"「褒められたの？」とトヨが聞く。"},{"no":336,"text":""},{"no":337,"text":"「確認します」"},{"no":338,"text":""},{"no":339,"text":"老人はチョコレートの包みを開けて、行ってしまった。"},{"no":340,"text":""},{"no":341,"text":"「小宮山さん」"},{"no":342,"text":""},{"no":343,"text":"「なあに」"},{"no":344,"text":""},{"no":345,"text":"「豆腐代を、先にお取りください」"},{"no":346,"text":""},{"no":347,"text":"「あらやだ」"},{"no":348,"text":""},{"no":349,"text":"トヨの手が、小銭入れに行く。"},{"no":350,"text":""},{"no":351,"text":"「忘れてたわ。いつも、これでなくなるのよ」"},{"no":352,"text":""},{"no":353,"text":"「予定表では、帰りが豆腐屋です」"},{"no":354,"text":""},{"no":355,"text":"「予定表に、ばあさんも入ってるの」"},{"no":356,"text":""},{"no":357,"text":"「入っています」"},{"no":358,"text":""},{"no":359,"text":"店の裏の小窓で、特殊景品が千円札に替わった。"},{"no":360,"text":""},{"no":361,"text":"トヨは千円札を二枚、小さく折って、小銭入れの奥にしまった。"},{"no":362,"text":""},{"no":363,"text":"◇"},{"no":364,"text":""},{"no":365,"text":"商店街の豆腐屋は、シャッターが全部上がっていた。"},{"no":366,"text":""},{"no":367,"text":"湯気の向こうで、白い前掛けの女将が顔を上げる。"},{"no":368,"text":""},{"no":369,"text":"「トヨさん、いらっしゃい」"},{"no":370,"text":""},{"no":371,"text":"「一丁ね。木綿」"},{"no":372,"text":""},{"no":373,"text":"「はいよ」"},{"no":374,"text":""},{"no":375,"text":"水の中から、四角い豆腐が持ち上がった。"},{"no":376,"text":""},{"no":377,"text":"トヨはレジの横を見ていた。"},{"no":378,"text":""},{"no":379,"text":"小さな砂時計が、籠に三つ並んでいる。台紙に「ゆで卵　三分」とある。"},{"no":380,"text":""},{"no":381,"text":"「これ、いただくわ」"},{"no":382,"text":""},{"no":383,"text":"「それ、おまけで置いてた子よ」"},{"no":384,"text":""},{"no":385,"text":"「買うわ。三百円？」"},{"no":386,"text":""},{"no":387,"text":"「百五十円」"},{"no":388,"text":""},{"no":389,"text":"トヨは小銭入れから、コインを数えて出した。"},{"no":390,"text":""},{"no":391,"text":"律は口を挟んだ。"},{"no":392,"text":""},{"no":393,"text":"「小宮山さん。三分では、三十分は測れません」"},{"no":394,"text":""},{"no":395,"text":"「測らなくていいのよ」"},{"no":396,"text":""},{"no":397,"text":"トヨは砂時計をひっくり返した。砂が落ち始める。"},{"no":398,"text":""},{"no":399,"text":"「先生のあの、ジリジリは、ばあさんの心臓に悪いわ」"},{"no":400,"text":""},{"no":401,"text":"「申し訳ありません」"},{"no":402,"text":""},{"no":403,"text":"「だから、砂にするの」"},{"no":404,"text":""},{"no":405,"text":"「三分で、何を測るのですか」"},{"no":406,"text":""},{"no":407,"text":"「迷う時間よ」"},{"no":408,"text":""},{"no":409,"text":"トヨは砂を見ていた。"},{"no":410,"text":""},{"no":411,"text":"「ばあさんはね、どうしようかしらを、三分でやめるの」"},{"no":412,"text":""},{"no":413,"text":"律は口を開けた。"},{"no":414,"text":""},{"no":415,"text":"三分で迷いが終わるかどうか。確認なら、できる。"},{"no":416,"text":""},{"no":417,"text":"閉じた。"},{"no":418,"text":""},{"no":419,"text":"「はい」"},{"no":420,"text":""},{"no":421,"text":"「あら、また言いたい顔」"},{"no":422,"text":""},{"no":423,"text":"「今回は、ありません」"},{"no":424,"text":""},{"no":425,"text":"「えらいわ」"},{"no":426,"text":""},{"no":427,"text":"砂は、半分近く落ちている。"},{"no":428,"text":""},{"no":429,"text":"「先生」"},{"no":430,"text":""},{"no":431,"text":"「はい」"},{"no":432,"text":""},{"no":433,"text":"「日曜のお昼に、湯豆腐でもどう？　ひとりだと、お鍋が大きいのよ」"},{"no":434,"text":""},{"no":435,"text":"「日曜は、実家に帰る予定です」"},{"no":436,"text":""},{"no":437,"text":"「あら、お帰りなさるの」"},{"no":438,"text":""},{"no":439,"text":"「はい。まだ、母に言っていませんが」"},{"no":440,"text":""},{"no":441,"text":"「予定なのに？」"},{"no":442,"text":""},{"no":443,"text":"「予定です」"},{"no":444,"text":""},{"no":445,"text":"トヨは砂時計を持った手を、少し下げた。"},{"no":446,"text":""},{"no":447,"text":"「じゃあ、来週ね」"},{"no":448,"text":""},{"no":449,"text":"「来週の日曜は、二十九日です」"},{"no":450,"text":""},{"no":451,"text":"「そうね」"},{"no":452,"text":""},{"no":453,"text":"「確認します」"},{"no":454,"text":""},{"no":455,"text":"「確認しなくていいのよ、湯豆腐は」"},{"no":456,"text":""},{"no":457,"text":"砂が落ち切った。"},{"no":458,"text":""},{"no":459,"text":"トヨは何も言わず、もう一度ひっくり返した。"},{"no":460,"text":""},{"no":461,"text":"◇"},{"no":462,"text":""},{"no":463,"text":"二十時。"},{"no":464,"text":""},{"no":465,"text":"二〇二号室の机で、律はスマホを手に持っていた。"},{"no":466,"text":""},{"no":467,"text":"日曜ではない。母から来る電話を、律のほうから先に鳴らす。"},{"no":468,"text":""},{"no":469,"text":"三回で、つながった。"},{"no":470,"text":""},{"no":471,"text":"『ちゃんとしてる？』"},{"no":472,"text":""},{"no":473,"text":"「しています。パチンコに行きました」"},{"no":474,"text":""},{"no":475,"text":"向こう側で、音が途切れた。"},{"no":476,"text":""},{"no":477,"text":"息の間が、一拍あった。"},{"no":478,"text":""},{"no":479,"text":"『……パチンコ』"},{"no":480,"text":""},{"no":481,"text":"「火曜と、今日の二回です。火曜は三千円で二十七分、今日は千円で九分でした」"},{"no":482,"text":""},{"no":483,"text":"『そう』"},{"no":484,"text":""},{"no":485,"text":"「お父さんに、全部済んだと伝えてください」"},{"no":486,"text":""},{"no":487,"text":"『自分で言いなさい。書斎にいるわ』"},{"no":488,"text":""},{"no":489,"text":"「いまは、準備ができていません」"},{"no":490,"text":""},{"no":491,"text":"『そう言うと思った』"},{"no":492,"text":""},{"no":493,"text":"『どこのお店？』"},{"no":494,"text":""},{"no":495,"text":"「商店街の、パーラーひまわりです」"},{"no":496,"text":""},{"no":497,"text":"『駅前の店じゃなくて？』"},{"no":498,"text":""},{"no":499,"text":"「前橋の駅前の店ではありません。小金井です」"},{"no":500,"text":""},{"no":501,"text":"『そう』"},{"no":502,"text":""},{"no":503,"text":"母の声が、少し遠くなった。"},{"no":504,"text":""},{"no":505,"text":"『音は、大きかったでしょう』"},{"no":506,"text":""},{"no":507,"text":"「はい。ドアが開くと、手が上がりました」"},{"no":508,"text":""},{"no":509,"text":"『上がったの』"},{"no":510,"text":""},{"no":511,"text":"「耳の高さまで」"},{"no":512,"text":""},{"no":513,"text":"受話器の向こうで、母が息を吸う音がした。"},{"no":514,"text":""},{"no":515,"text":"律は目を閉じた。"},{"no":516,"text":""},{"no":517,"text":"駅前の自動ドアが開く。音が流れ出る。"},{"no":518,"text":""},{"no":519,"text":"母の手のひらが、両耳にかぶさっている。温かい。"},{"no":520,"text":""},{"no":521,"text":"その手の内側で、高い声が鳴り続ける。やまない。"},{"no":522,"text":""},{"no":523,"text":"泣いているのは、小さな自分だ。"},{"no":524,"text":""},{"no":525,"text":"ドアが開くたび、大きな音に、泣いた。母の手はそのたびに来た。"},{"no":526,"text":""},{"no":527,"text":"「お母さん」"},{"no":528,"text":""},{"no":529,"text":"『なあに』"},{"no":530,"text":""},{"no":531,"text":"「聞かせてはいけない音だったから、と、わたしは理解していました」"},{"no":532,"text":""},{"no":533,"text":"『……誰かが、そう言ったの？』"},{"no":534,"text":""},{"no":535,"text":"「誰にも言われていません」"},{"no":536,"text":""},{"no":537,"text":"『そうね。言ってないわね』"},{"no":538,"text":""},{"no":539,"text":"母は、そのあと少し黙った。"},{"no":540,"text":""},{"no":541,"text":"『あなた、あの日は』"},{"no":542,"text":""},{"no":543,"text":"そこで止まった。"},{"no":544,"text":""},{"no":545,"text":"律は待った。"},{"no":546,"text":""},{"no":547,"text":"秒針が四回進んだ。"},{"no":548,"text":""},{"no":549,"text":"『……ご飯を、多めに炊いておくわね』"},{"no":550,"text":""},{"no":551,"text":"「あの日は、何ですか」"},{"no":552,"text":""},{"no":553,"text":"『いいの。なんでもないのよ』"},{"no":554,"text":""},{"no":555,"text":"「日曜に、帰ります」"},{"no":556,"text":""},{"no":557,"text":"『急ね』"},{"no":558,"text":""},{"no":559,"text":"「月曜が祝日です。お父さんにも、報告があります」"},{"no":560,"text":""},{"no":561,"text":"『そう。気をつけておいでなさい』"},{"no":562,"text":""},{"no":563,"text":"通話が切れた。"},{"no":564,"text":""},{"no":565,"text":"画面に「一分四十秒」と出ている。"},{"no":566,"text":""},{"no":567,"text":"ノートを開く。"},{"no":568,"text":""},{"no":569,"text":"「二十日（金）十時三分〜十時三十三分」"},{"no":570,"text":""},{"no":571,"text":"「千円　九分（一分あたり百十一円。火曜と同じ）」"},{"no":572,"text":""},{"no":573,"text":"「残り　二十一分　観察。小宮山さん　当たり一回」"},{"no":574,"text":""},{"no":575,"text":"「タイマー　鳴動一回（店内の視線　推定十人以上）」"},{"no":576,"text":""},{"no":577,"text":"「豆腐　木綿一丁。砂時計　百五十円。小宮山さんが購入」"},{"no":578,"text":""},{"no":579,"text":"「母　日曜の件　了承」"},{"no":580,"text":""},{"no":581,"text":"最後に、新しい行を書いた。"},{"no":582,"text":""},{"no":583,"text":"「勝った日の決まり」"},{"no":584,"text":""},{"no":585,"text":"その下は、空けた。"},{"no":586,"text":""},{"no":587,"text":"ペンを置く。"},{"no":588,"text":""},{"no":589,"text":"次の頁をめくって、日付だけ書いた。"},{"no":590,"text":""},{"no":591,"text":"「二十二日（日）　実家　父に、誘う」"}],"illus":[]}